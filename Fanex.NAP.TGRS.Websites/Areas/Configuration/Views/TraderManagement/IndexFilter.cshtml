<div class="filter-bar">
    <div id="divTraderFilterForm" class="filter-form">
        <div id="divErrorSuccessMsg" class="inline-message"></div>
        <div class="filter-row">
            <div class="lbl-field width-auto">
                <label for="txtUserName">@ViewLang.Username</label>
            </div>
            <div class="edit-field col_2">
                <input type="text" id="txtUserName" maxlength="50"/>
            </div>
            <div class="lbl-field width-auto" >
                <label for="txtEmployeeId">@ViewLang.EmployeeId</label>
            </div>
            <div class="edit-field col_2">
                <input type="text" id="txtEmployeeId" maxlength="50"/>
            </div>
            <div class="lbl-field width-auto">
                <label for="ddlTeam">@ViewLang.Team</label>
            </div>
            <div class="edit-field col_2">
                <select id="ddlTeam" class="width-80"></select>
            </div>
            <div class="lbl-field width-auto">
                <label for="ddlGrade">@ViewLang.Grade</label>
            </div>
            <div class="edit-field col_2">
                <select id="ddlGrade" class="width-80"></select>
            </div>
            <div class="submit col_1">
                <input id="btnSearch" type="submit" class="blue-button float-right" value="Search">
            </div>
        </div>
    </div>
</div>