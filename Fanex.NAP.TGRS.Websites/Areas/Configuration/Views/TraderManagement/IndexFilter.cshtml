<div class="filter-bar">
    <div id="divTraderFilterForm" class="filter-form">
        <div class="filter-row">
            <div class="lbl-field col_3">
                <label for="txtUserName">@ViewLang.Username</label>
            </div>
            <div class="edit-field col_5">
                <input type="text" id="txtUserName" class="width-150" maxlength="50" />
            </div>
            <div class="lbl-field col_4">
                <label for="txtEmployeeId">@ViewLang.EmployeeId</label>
            </div>
            <div class="edit-field col_5">
                <input type="text" id="txtEmployeeId" class="width-150" maxlength="20" />
            </div>
            <div class="lbl-field col_2">
                <label for="ddlTeam">@ViewLang.Team</label>
            </div>
            <div class="edit-field col_7">
                <select id="ddlTeam">
                </select>
            </div>
            <div class="lbl-field col_2">
                <label for="ddlGrade">@ViewLang.Grade</label>
            </div>
            <div class="edit-field col_5">
                <select id="ddlGrade">
                </select>
            </div>
            <div class="submit col_4">
                <input id="btnSearch" type="submit" class="blue-button float-right" value="Search">
            </div>
        </div>
    </div>
</div>