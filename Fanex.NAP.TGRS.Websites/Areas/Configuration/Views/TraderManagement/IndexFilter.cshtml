<div class="filter-bar">
    <div id="divTraderFilterForm" class="filter-form">
        <div id="divErrorSuccessMsg" class="inline-message"></div>
        <div class="filter-row">
            <div class="lbl-field">
                <label for="txtUserName">@ViewLang.UserName</label>
            </div>
            <div class="edit-field">
                <input type="text" id="txtUserName" class="user-name" maxlength="50"/>
            </div>
            <div class="lbl-field">
                <label for="txtEmployeeId">@ViewLang.EmployeeId</label>
            </div>
            <div class="edit-field">
                <input type="text" id="txtEmployeeId" class="employee-id" maxlength="50"/>
            </div>
        </div>
        <div class="filter-row">
            <div class="lbl-field">
                <label for="ddlTeam">@ViewLang.Team</label>
            </div>
            <div class="edit-field">
                <select id="ddlTeam" class="combobox-autocomplete sport"></select>
            </div>
            <div class="lbl-field">
                <label for="ddlGrade">@ViewLang.Grade</label>
            </div>
            <div class="edit-field">
                <select id="ddlGrade" class="combobox-autocomplete width-180"></select>
            </div>
        </div>
    </div>
</div>