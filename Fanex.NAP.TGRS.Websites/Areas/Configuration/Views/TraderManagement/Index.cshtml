@using Fanex.NAP.TGRS.Configuration.ViewModel.TraderManagement
@using Fanex.NAP.TGRS.Core.Resources
@{
    ViewBag.Title = ViewLang.TraderManagement;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Styles.Render("~/styles/TraderManagement")
@section Headline {
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
    @if (ViewBag.HasEditRight)
    {
        <div class="header-button">
            <a href="#" id="lnkAddNewTrader" class="green-button change-list"><span class="add-icon">
            </span>@ViewLang.NewTrader</a>
        </div>
    }
}
@Html.Partial("IndexFilter")
<div id="resultContainer" class="content-grid display-none">
    <div id="divTradersGrid" class="freegrid">
    </div>
</div>
<div id="divHiddenForm" class="display-none">
    @Html.Partial("InsertTraderForm")
    @Html.Partial("UpdateTraderForm")
    @Html.Partial("GradeHistoryForm")
    @Html.Partial("TeamHistoryForm")
    <div id="divShiftHistoryForm" class="min-width-history">
        <div id="resultContainer" class="display-none">
            <div id="divShiftHistoryGrid" class="freegrid">
            </div>
        </div>
    </div>
</div>
@section Foot
{
    @Scripts.Render("~/scripts/TraderManagement")
    <script type="text/javascript">
        var labels = {
            UserName: '@ViewLang.Username',
            EmployeeId: '@ViewLang.EmployeeId',
            Team: '@ViewLang.Team',
            Grade: '@ViewLang.Grade',
            Shift: '@ViewLang.Shift',
            Remark: '@ViewLang.Remark',
            CreatedDate: '@ViewLang.CreatedDate',
            CreatedBy: '@ViewLang.CreatedBy',
            NewTrader: '@ViewLang.NewTrader',
            EditTrader: '@ViewLang.EditTrader',
            AllTeams: '@ViewLang.AllTeams',
            AllGrades: '@ViewLang.AllGrades',
            AllShifts: '@ViewLang.AllShift',
            SelectATeam: '@ViewLang.SelectATeam',
            SelectAGrade: '@ViewLang.SelectAGrade',
            SelectAShift: '@ViewLang.SelectAShift',
            EffectiveDate: '@ViewLang.EffectiveDate',
            TeamEffectiveDate: '@ViewLang.TeamEffectiveDate',
            GradeEffectiveDate: '@ViewLang.GradeEffectiveDate',
            ShiftEffectiveDate: '@ViewLang.ShiftEffectiveDate',
            GradeHistory: '@ViewLang.GradeHistory',
            TeamHistory: '@ViewLang.TeamHistory',
            ShiftHistory: '@ViewLang.ShiftHistory'
        };
        var messages = {
            UpdateTraderSuccessfully: '@Messages.UpdateTraderSuccessfully',
            UpdateNoChange: '@Messages.UpdateNoChange',
            AddTraderSuccessfully: '@Messages.AddTraderSuccessfully',
            InvalidValueError: '@Messages.InvalidValueError',
            RequiredFieldError: '@Messages.RequiredFieldError'
        };
        var hasEditRight = '@ViewBag.HasEditRight' === 'True';
        var datepickerSetting = {
            Today: '@DateTime.Today.ToShortFormatedDate()'
        };
    </script>
}