@using Fanex.NAP.TGRS.Configuration.ViewModel.BenchmarkManagement
@{
    ViewBag.Title = ViewLang.BenchmarkManagement;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
    @Styles.Render("~/styles/benchmarkManagement")
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
    <div class="header-button">
        <a href="#" id="lnkLeague" class="green-button change-list"><span class="list-icon"></span>@ViewLang.League</a>
        <a href="#" id="lnkTeam" class="green-button change-list"><span class="list-icon"></span>@ViewLang.Team</a>
        <a href="#" id="lnkBack" class="back-button hide"><span class="back-icon">← </span>@ViewLang.Back</a>
    </div>
}
<div id="divLeagueBMContent">
    <div class="filter-bar">
        <div id="divLeagueBMFilter" class="filter-form">
            <div class="filter-row">
                <div class="lbl-field col_2">
                    <label for="ddlSport">@ViewLang.Sport</label>
                </div>
                <div class="edit-field col_7">
                    <select id="ddlSport" class="width-160">
                        <option value="1">@ViewLang.Soccer</option>
                    </select>
                </div>
                <div class="lbl-field col_4">
                    <label for="ddlSpecialLeague">@ViewLang.SpecialLeague</label>
                </div>
                <div class="edit-field col_7">
                    <select id="ddlSpecialLeague" class="width-160">
                        @if (ViewBag.SpecialLeagues != null)
                        {
                            foreach (SpecialLeagueItem league in (IEnumerable<SpecialLeagueItem>)ViewBag.SpecialLeagues)
                            {
                                <option value="@league.Code">@league.DisplayName</option>
                            }
                        }
                    </select>
                </div>
                <div class="lbl-field col_2 align-right">
                    <label for="txtLeague">@ViewLang.League</label>
                </div>
                <div class="edit-field col_12 align-left">
                    <input type="text" id="txtLeague" class="width-250" />
                </div>
            </div>
            <div class="filter-row">
                <div class="lbl-field col_2 align-right">
                    <label for="ddlCountry">@ViewLang.Country</label>
                </div>
                <div class="edit-field col_7 align-left">
                    <select id="ddlCountry" class="width-160">
                        @if (ViewBag.Countries != null)
                        {
                            foreach (CountryItem country in (IEnumerable<CountryItem>)ViewBag.Countries)
                            {
                                <option value="@country.CountryCode">@country.CountryName</option>
                            }
                        }
                    </select>
                </div>
                <div class="lbl-field col_4 align-right">
                    <label for="ddlMarket">@ViewLang.Market</label>
                </div>
                <div class="edit-field col_7 align-left">
                    <select id="ddlMarket" class="width-160">
                        <option value="-1">@ViewLang.AllMarkets</option>
                        <option value="1">@ViewLang.MainMarkets</option>
                        <option value="0">@ViewLang.OtherMarkets</option>
                    </select>
                </div>
                <div class="submit width-auto col_4">
                    <input id="btnSearch" type="button" class="blue-button" value="@ViewLang.Search" />
                </div>
            </div>
        </div>
    </div>
    <div id="divLeagueBMGridContainer" class="content-grid display-none">
        <div id="divLeagueBMGrid" class="freegrid"></div>
    </div>
</div>
<div id="divTeamBMContent" class="display-none">
    <div id="divTeamBMGridContainer" class="content-grid display-none">
        <div id="divTeamBMGrid" class="freegrid"></div>
    </div>
</div>
<div id="divBetTypeBMContent" class="display-none">
    <div class="league-title">
        <span class="league">@ViewLang.League:</span>
        <span id="spanLeagueName"></span>
    </div>
    <div id="divBetTypeBMGridContainer" class="content-grid display-none">
        <div id="divBetTypeBMGrid" class="freegrid"></div>
    </div>
</div>
<div id="divPopupContent" class="display-none">
    <div id="divProfitMargin" class="freegrid profit-margin-popup"></div>
</div>
<div id="bettypeProfitMarginPopup" class="display-none">
    <div id="bettypeprofitMarginContent" class="freegrid profit-margin-popup-content"></div>
</div>
@section Foot
{
    @Scripts.Render("~/scripts/benchmarkManagement")
    <script type="text/javascript">
        var labels = {
            No: '#',
            Sport: '@ViewLang.Sport',
            League: '@ViewLang.League',
            AvgProfitMargin: '@ViewLang.AvgProfitMargin',
            ProfitMargin: '@ViewLang.ProfitMargin',
            Benchmark: '@ViewLang.Benchmark',
            BetTypeBM: '@ViewLang.BetTypeBM',
            Configure: '@ViewLang.Configure',
            TeamName: '@ViewLang.TeamName',
            Percentage: '@ViewLang.BetType',
            LeagueName: '@ViewLang.LeagueName',
            BetType: '@ViewLang.BetType',
            Year: '@ViewLang.Year',
            ProfitMargin_2Years: '@ViewLang.ProfitMargin_2Years',
            ProfitMargin_3Years: '@ViewLang.ProfitMargin_3Years',
            ProfitMargin_4Years: '@ViewLang.ProfitMargin_4Years',
            Afternoon: '@ViewLang.Afternoon',
            Night: '@ViewLang.Night',
            Midnight: '@ViewLang.Midnight',
            Afternoon_Shift: '@ViewLang.Afternoon_Shift',
            Night_Shift: '@ViewLang.Night_Shift',
            Midnight_Shift: '@ViewLang.Midnight_Shift',
            Total: '@ViewLang.Total',
            Win_Loss: '@ViewLang.WinLoss',
            Turnover: '@ViewLang.Turnover'
        };
        var messages = {
            UpdateBenchmarkConfirmMessage: '@Messages.UpdateBenchmarkConfirmMessage',
            UpdateBenchmarkSuccessfully: '@Messages.UpdateBenchmarkSuccessfully',
            InvalidValueError: '@Messages.InvalidValueError'
        };
        var hasEditRight = '@ViewBag.HasEditRight' === 'True';
    </script>
}