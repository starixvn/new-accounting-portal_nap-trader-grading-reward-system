@{
    ViewBag.Title = ViewLang.SpreadManagement;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model Fanex.NAP.TGRS.Configuration.Criteria.SpreadManagement.GetAllSpreadCriteria
@section Head
{
    @Styles.Render("~/styles/spreadManagement")
}
@section headline{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="uploader" class="row content">
    <div class="filter-bar">
        <div class="filter-form">
            <div class="filter-row">
                <div class="lbl-field col_5">
                    <label class="control-label" for="FileName">
                        Add/Edit
                    </label>
                </div>
                <div class="edit-field col_12">
                    <div class="clearable-field">
                        <input type="text" name="fileName" id="fileName" class="clearable-input" disabled
                               style="width: 300px;" />
                    </div>
                </div>
                <div class="col_4">
                    <button class="blue-button" id="browseBtn" type="button">
                        Browse
                    </button>
                </div>
                <input type="file" id="file" name="file" style="display: none" />
                <button id="uploadBtn" class="blue-button" type="button">
                    Upload
                </button>
            </div>
            <div class="filter-row">
                <a href="@Url.Action("DownloadTemplate")" style="margin-left:135px;">Download Template</a>
            </div>
            <div class="filter-row">
                <div class="lbl-field col_5">
                    <label class="control-label" for="League">
                        League
                    </label>
                </div>
                <div class="edit-field col_12">
                    <div class="clearable-field">
                        <input class="form-control input-sm" type="text" name="League" id="LeagueName" style="width: 300px">
                    </div>
                </div>
                <button class="blue-button" id="btnSearchSpread">
                    Search
                </button>
            </div>
        </div>
    </div>
</div>

<div id="resultContainer" class="content-grid" style="display: none;">
    <div id="divLeaguePerformanceGrid-grid-title" class="grid-title">
        <div class="grid-title-label" id="reporttile"></div>
        <div class="grid-toolbox">
            <input type="button" id="excelBtn" class="btnExcel" title="Export to Excel">
        </div>
    </div>
    <div id="divSpreadGrid" class="freegrid">
    </div>
</div>

<div>
    @Html.HiddenFor(s => s.PageSize)
    @Html.HiddenFor(s => s.PageIndex)
    @Html.HiddenFor(s => s.PageCount)
</div>

@if (ViewBag.HasEditRight)
{
    <div id="divHiddenForm" class="display-none">
        @Html.Partial("UploadResult")
    </div>
}

@section Foot{
    @Scripts.Render("~/scripts/spreadManagement")
    
    <script type="text/javascript">
        var messages = {
            UpdateSpreadConfirmMessage: '@Messages.UpdateSpreadConfirmMessage',
            UpdateSpreadSuccessfully: '@Messages.UpdateSpreadSuccessfully',
            DeleteSpreadConfirmMessage: '@Messages.DeleteSpreadConfirmMessage',
            DeleteSpreadSuccessfully: '@Messages.DeleteSpreadSuccessfully'
        };
    </script>
}
