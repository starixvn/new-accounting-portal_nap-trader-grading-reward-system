<div id="AddNewTeamForm" class="form-bar width-400">
    <div class="form expand-form">
        <div id="divErrorSuccessMsg" class="inline-message"></div>
        <div class="form-row">
            <div class="lbl-field width-80">
                <label>@ViewLang.Name</label>
            </div>
            <div class="edit-field">
                <input type="text" name="BettypeName" class="width-200 " data-val-required="@Messages.RequiredFieldError" maxlength="50" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-80">
                <label>@ViewLang.BettypeId</label>
            </div>
            <div class="edit-field">
                <input name="BettypeId" class="width-200" type="text"  data-max-length="200" data-val-required="@Messages.RequiredFieldError" data-val-length="@Messages.FieldMaxLengthError200" data-val-number="@ViewLang.NumberInput"/>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-80">
                <label>@ViewLang.Group</label>
            </div>
            <div class="edit-field">
                <select name="Group" class="ui-multiselect ui-widget ui-state-default" aria-haspopup="true" style="width: 206px">
                    <option value="1"  selected>Major</option>
                    <option value="2">Minor</option>
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-80">
                <label>@ViewLang.OperatorType</label>
            </div>
            <div class="edit-field">
                <input name="OperatorType" class="width-200" type="text" data-max-length="200" data-val-required="@Messages.RequiredFieldError" data-val-length="@Messages.FieldMaxLengthError200" data-val-number="@ViewLang.NumberInput"/>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-80">
                <label>@ViewLang.AssignmentType</label>
            </div>
            <div class="edit-field">
                <input name="AssignmentType" class="width-200" type="text" data-max-length="200" data-val-length="@Messages.FieldMaxLengthError200" data-val-number="@ViewLang.NumberInput"data-val-required="@Messages.RequiredFieldError" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-80"></div>
            <div class="edit-field">
                <input name="IsUsedForJuice"  type="checkbox" /> Is Used For Juice    
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-80"></div>
            <div class="edit-field">
                <input name="Active" type="checkbox" /> Active
            </div>
        </div>
        <div class="form-row"></div>
        <div class="form-row button-row">
            <div class="lbl-field width-80">
            </div>
            <div class="edit-field">
                <input type="button" id="btnSave" class="blue-button" value="@ViewLang.Submit" />
                <input type="button" id="btnCancel" class="red-button" value="@ViewLang.Cancel" />
            </div>
        </div>
    </div>
</div>