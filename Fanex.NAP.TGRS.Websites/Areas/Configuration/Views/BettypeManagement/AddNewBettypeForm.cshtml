<div id="AddNewTeamForm" class="form-bar width-400">
    <div class="form expand-form">
        <div id="divErrorSuccessMsg" class="inline-message"></div>
        <div class="form-row">
            <div class="lbl-field width-80">
                <label>@ViewLang.Name</label>
            </div>
            <div class="edit-field">
                <input type="text" id="name" class="width-200 " data-val-required="@Messages.RequiredFieldError" maxlength="50" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-80">
                <label>@ViewLang.BettypeId</label>
            </div>
            <div class="edit-field">
                <input id="id" class="width-200" type="number"  data-max-length="200" data-val-length="@Messages.FieldMaxLengthError200"/>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-80">
                <label>@ViewLang.Group</label>
            </div>
            <div class="edit-field">
                <select class="width-200">
                    <option value="1">Major</option>
                    <option value="2">Minor</option>
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-80">
                <label>@ViewLang.OperatorType</label>
            </div>
            <div class="edit-field">
                <input id="operatorType" class="width-200" type="number" data-max-length="200" data-val-length="@Messages.FieldMaxLengthError200" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-80">
                <label>@ViewLang.AssignmentType</label>
            </div>
            <div class="edit-field">
                <input id="assignmentType" class="width-200" type="number" data-max-length="200" data-val-length="@Messages.FieldMaxLengthError200" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-80"></div>
            <div class="edit-field">
                <input id="juice" class="width-200" type="checkbox" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-80"></div>
            <div class="edit-field">
                <input id="active" class="width-200" type="checkbox" />
            </div>
        </div>
        <div class="form-row button-row">
            <div class="lbl-field width-80">
            </div>
            <div class="edit-field">
                <input type="button" id="btnSave" class="blue-button" value="@ViewLang.Submit" />
                <input type="button" id="btnCancel" class="red-button" value="@ViewLang.Cancel" />
            </div>
        </div>
    </div>
</div>