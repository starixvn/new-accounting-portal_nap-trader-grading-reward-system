@using Fanex.NAP.TGRS.Configuration.ViewModel.TeamManagement
@{
    ViewBag.Title = ViewLang.BettypeManagement;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Headline {
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>

    <div class="header-button">
        <a href="#" id="lnkAddNewTeam" class="green-button change-list">
            <span class="add-icon">
            </span>@ViewLang.NewBettype
        </a>
    </div>

}
<div id="resultContainer" class="content-grid">
    <div id="divTeamsGrid" class="freegrid">
    </div>
</div>

@*<div id="divHiddenForm" class="display-none">
    @Html.Partial("InsertTeamForm")
    @Html.Partial("UpdateTeamForm")
</div>*@

@section Foot
{
    @*@Scripts.Render("~/scripts/teamManagement")*@
    @Scripts.Render("~/scripts/bettypeManagement")

    <script type="text/javascript">
        var bettypeColumns = [@Html.Raw(ViewBag.BettypeColumns)];
        var labels = {
            TeamName: '@ViewLang.TeamName',
            Description: '@ViewLang.Description',
            TraderCount: '@ViewLang.TraderCount',
            CreatedDate: '@ViewLang.CreatedDate',
            CreatedBy: '@ViewLang.CreatedBy',
            NewTeam: '@ViewLang.NewTeam',
            EditTeam: '@ViewLang.EditTeam',
            AvgGrade: '@ViewLang.AvgGrade'
        };
        var messages = {
            UpdateTeamSuccessfully: '@Messages.UpdateTeamSuccessfully',
            AddTeamSuccessfully: '@Messages.AddTeamSuccessfully',
            InvalidValueError: '@Messages.InvalidValueError'
        };
        var hasEditRight = '@ViewBag.HasEditRight' === 'True';
    </script>
}