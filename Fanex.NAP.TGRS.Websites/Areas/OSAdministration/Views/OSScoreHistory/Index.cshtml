@using Fanex.NAP.TGRS.Core.Resources
@{
    ViewBag.Title = ViewLang.ScoreHistory;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Headline {
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="scoreHistoryContainer" class="content-grid" hidden>
    <div id="divScoreHistoryGrid" class="freegrid">
    </div>
</div>

<div id="scoreHistoryDetailContainer" class="content-grid" hidden>
    <div id="divScoreHistoryDetailGrid" class="freegrid">
    </div>
</div>

@section Foot
{
    @Scripts.Render("~/scripts/os-score-history")
    <script type="text/javascript">
        var labels = {
            FromDate: '@ViewLang.FromDate',
            ToDate: '@ViewLang.ToDate',
            ConfirmedDate: '@ViewLang.ConfirmedDate',
            ConfirmedBy: '@ViewLang.ConfirmedBy',
            ScoreHistoryName: '@ViewLang.ScoreHistoryName',
            Remove: '@ViewLang.Remove',
            PeriodName: '@ViewLang.PeriodName'
        };

        var messages = {
            DeleteScoreHistorySuccessfully: '@Messages.DeleteScoreHistorySuccessfully',
            DeleteScoreHistoryConfirmMessage: '@Messages.DeleteScoreHistoryConfirmMessage',
            InternalErrorMessage: '@Messages.InternalErrorMessage'
        };
        var hasEditRight = '@ViewBag.HasEditRight' === 'True';
    </script>
}
