@{
    ViewBag.Title = "Score Confirmation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head
{
    @Styles.Render("~/styles/trader-performance")
}

@section Headline{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}

<div class="filter-bar">
    <div id="divReportFilterForm" class="filter-form">
        <div class="filter-row ">
            <div class="date-range"><div id="divDateRange"></div></div>
            <div class="lbl-field col_3 trader-bm"></div>
            <div class="submit col_4">
                <input id="btnSearch" type="button" class="blue-button" value="@ViewLang.Generate" />
                <input id="btnConfirm" type="button" class="blue-button" value="@ViewLang.Generate" />
            </div>
        </div>
    </div>
</div>

<div id="resultContainer" class="content-grid hide">
    <div id="divGrid" class="freegrid">
    </div>
</div>

@section Foot
{
    @Scripts.Render("~/scripts/os-score-confirmation")

    <script type="text/javascript">
        var labels = {
            TraderPerformance: '@ViewLang.TraderPerformance'
        };
        var messages = {
            StoreTraderScoreSuccessfully: '@Messages.UpdateTraderSuccessfully',
            PeriodExistedError: '@Messages.InvalidValueError',

        };
        var hasEditRight = '@ViewBag.HasEditRight' === 'True';

        var datepickerSetting = {
            MinDate: '@(((DateTime)ViewBag.MinDate).ToShortFormatedDate())',
            DefaultFromDate: '@(((DateTime)ViewBag.DefaultFromDate).ToShortFormatedDate())',
            DefaultToDate: '@(((DateTime)ViewBag.DefaultToDate).ToShortFormatedDate())',
            AllowYearRange: parseInt('@ViewBag.AllowYearRange')
        };
    </script>
}