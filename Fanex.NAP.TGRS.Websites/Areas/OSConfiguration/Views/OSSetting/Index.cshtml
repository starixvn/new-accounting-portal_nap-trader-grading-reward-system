@using dotless.Core.Parser.Tree
@{
    ViewBag.Title = "Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Styles.Render("~/styles/bootstrap")
@Styles.Render("~/styles/common")
@Styles.Render("~/styles/normal")

@section Headline {
    <div class="title" style="margin-left: 25px">
        <div>
            <span>@ViewBag.Title</span>
        </div>
    </div>
}

<div class="row">
    <div class="col-md-1"></div>
    <div class="col-md-10">
        @Html.Partial("Target")
        @Html.Partial("Parameter")
    </div>
    <div class="col-md-1"></div>
</div>

@section Foot
{
    @Scripts.Render("~/scripts/os-setting")

    <script>
        var messages = {
            NotANumber: '@Messages.NotANumberError',
            InvalidValue: '@Messages.InvalidValueError'
        }
    </script>
}

