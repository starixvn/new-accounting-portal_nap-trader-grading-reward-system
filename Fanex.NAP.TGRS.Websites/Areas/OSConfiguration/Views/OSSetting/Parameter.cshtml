<div class="panel panel-default">
    <div class="panel-heading" style="background-color: #5a7dc1; color: white">Parameter</div>
    <div class="panel-body">
        Increment Times
        <a id="IncrementTimes" style="margin-left: 14px;" class="parameter @(ViewBag.HasEditRight? "paramLink": "param-unLink")"></a>
        <input id="txtincrementTimes"
               style="width: 40px; visibility: hidden; margin-left: 10px"
               data-val-number="@Messages.NotANumberError"
               maxlength="5"
               data-integer />
        <br />
        Increment Value
        <a id="IncrementValue" style="margin-left: 17px" class="parameter @(ViewBag.HasEditRight? "paramLink": "param-unLink")"></a>
        <input id="txtincrementValue"
               style="width: 40px; visibility: hidden; margin-left: 13px"
               data-val-number="@Messages.NotANumberError"
               maxlength="5" />
        <br />
        Floor Mark
        <a id="FloorMark" style="margin-left: 50px;" class="parameter @(ViewBag.HasEditRight? "paramLink": "param-unLink")"></a>
        <input id="txtfloorMark"
               style="width: 40px; visibility: hidden; margin-left: 47px"
               data-val-number="@Messages.NotANumberError"
               maxlength="5"
               data-integer />
    </div>
</div>
