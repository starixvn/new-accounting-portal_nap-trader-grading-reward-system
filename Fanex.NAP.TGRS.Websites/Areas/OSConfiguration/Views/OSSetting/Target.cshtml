<div class="panel panel-default">
    <div class="panel-heading" style="background-color: #5a7dc1; color: white">Target</div>
    <div class="panel-body">
        <div id="globalTargetForm" style="margin-bottom: 20px; height: 30px">
            <span>Global Target (%)</span>
            <a id="globalTarget" style="margin-left: 17px;; cursor: pointer;text-decoration: underline" class="parameter"></a>
            <input id="txtGlobalTarget"
                   style="width: 40px; margin-left: 10px; visibility: hidden"
                   data-val-number="@Messages.NotANumberError"
                   maxlength="5" />
            <span class="glyphicon glyphicon-question-sign" data-toggle="tooltip" title="@ViewLang.GlobalTarget"
                  style="float: left; left: 180px; top: 4px"></span>
        </div>

        <fieldset>
            <legend>Add special target</legend>
            <div class="filter-bar" style="background-color: white; border: none !important;">
                <div id="addSettingForm" class="filter-form">
                    <div class="filter-row">
                        <div class="edit-field col_12">
                            <select id="sport"
                                    style="height: 25px"></select>
                        </div>

                        <div class="edit-field col_8">
                            <select id="league"
                                    style="height: 25px; visibility: hidden">
                                <option value="-1">All league</option>
                            </select>
                        </div>
                    </div>

                    <div class="filter-row">
                        <div class="edit-field col_12">
                            <select id="optBettype">
                                <option value="-1">All Bettypes</option>
                            </select>
                        </div>

                        <div class="edit-field col_12">
                            <input id="targetValue"
                                   type="text"
                                   maxlength="50"
                                   data-val-required="@Messages.RequiredFieldError"
                                   data-val-number="@Messages.NotANumberError"
                                   style="height: 25px; width: 268px"
                                   placeholder="Input the target value (%) ..." />
                        </div>

                        <div class="col_8">
                            <button id="btnAdd" class="green-button">
                                <span class="glyphicon glyphicon-plus"></span>
                                Add
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-grid">
                <div id="targetGrid" class="freegrid">

                </div>
            </div>
        </fieldset>
    </div>
</div>
