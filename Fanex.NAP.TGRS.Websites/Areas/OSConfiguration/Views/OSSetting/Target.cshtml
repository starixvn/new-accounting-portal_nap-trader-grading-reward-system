<div class="panel panel-default">
    <div class="panel-heading" style="background-color: #5a7dc1; color: white">Target</div>
    <div class="panel-body">
        <div id="globalTargetForm" style="margin-bottom: 20px; height: 30px">
            <span>Global Target (%)</span>
            <a id="globalTarget" style="margin-left: 17px;">20</a>
            <input id="txtGlobalTarget"
                   style="width: 40px; margin-left: 10px; margin-right: 10px;visibility: hidden"
                   data-val-number="@Messages.NotANumberError"
                   maxlength="5" />
        </div>

        <fieldset>
            <legend>Add special target</legend>
            <div class="filter-bar" style="background-color: white; border: none !important;">
                <div id="addSettingForm" class="filter-form">
                    <div class="filter-row">
                        <div class="edit-field col_8">
                            <input id="txtSport"
                                   type="text"
                                   class="width-200"
                                   maxlength="50"
                                   data-val-not-html="@Messages.HtmlInputError"
                                   data-val-required="@Messages.RequiredFieldError"
                                   style="height: 25px"
                                   placeholder='Select a sport' />
                        </div>

                        <div class="edit-field col_5">
                            <input id="txtLeague"
                                   type="text"
                                   class="width-200"
                                   maxlength="50"
                                   data-val-not-html="@Messages.HtmlInputError"
                                   style="height: 25px"
                                   placeholder="Select a league" />
                        </div>
                    </div>

                    <div class="filter-row">
                        <div class="edit-field col_8">
                            <select id="optBettype" class="width-200" style="color: rgb(173, 172, 172)">
                                <option value="-1">All bet type</option>
                            </select>
                        </div>

                        <div class="edit-field col_8">
                            <input id="targetValue"
                                   type="text"
                                   class="width-200"
                                   maxlength="50"
                                   data-val-required="@Messages.RequiredFieldError"
                                   data-val-number="@Messages.NotANumberError"
                                   style="height: 25px"
                                   placeholder="Input the target value (%)" />
                        </div>
                    </div>
                    <div class="filter-row">
                        <button id="btnAdd" class="green-button">
                            <span class="glyphicon glyphicon-plus"></span>
                            Add
                        </button>
                    </div>
                </div>
            </div>

            <div class="content-grid">
                <div id="targetGrid" class="freegrid">
                    
                </div>
            </div>
        </fieldset>
    </div>
</div>
