<div id="divUpdateGradeForm" class="form-bar width-400">
    <div class="form expand-form">
        <div id="divErrorSuccessMsg" class="inline-message"></div>
        <div class="form-row">
            <div class="lbl-field width-80">
                <label>@ViewLang.GradeName</label>
            </div>
            <div class="edit-field">
                <input type="text" id="txtGradeName" class="width-200" data-val-required="@Messages.RequiredFieldError" data-max-length="50" data-val-length="@Messages.FieldMaxLengthError50"/>
                <input type="hidden" id="txtGradeId" />
            </div>
        </div>
        <div class="form-row" style="display: none;">
            <div class="lbl-field width-80">
                <label>@ViewLang.Description</label>
            </div>
            <div class="edit-field">
                <textarea rows="3" id="txtGradeDes" class="width-200" data-max-length="200" data-val-length="@Messages.FieldMaxLengthError200"></textarea>
            </div>
        </div>
        <div class="form-row button-row">
            <div class="lbl-field width-80"></div>
            <div class="edit-field">
                <input type="button" id="btnSave" class="blue-button" value="@ViewLang.Submit" />
                <input type="button" id="btnCancel" class="red-button" value="@ViewLang.Cancel" />
            </div>
        </div>
    </div>
</div>