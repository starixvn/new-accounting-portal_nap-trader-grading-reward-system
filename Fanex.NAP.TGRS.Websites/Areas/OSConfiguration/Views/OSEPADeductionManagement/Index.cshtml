@{
    ViewBag.Title = "EPA Deduction Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Headline {
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}

@Html.Partial("IndexFilter")

<div id="resultContainer" class="content-grid" hidden>
    <div id="divEPAGrid" class="freegrid">
    </div>
</div>

<div id="divHiddenTraderIssueForm" class="display-none">
    @Html.Partial("InsertTraderIssue")
    <div id="popupGrid" class="freegrid hidden"></div>
</div>

<div class="display-none">
    <div id="divEPADeductionHistoryForm" style="min-width:738px;">
        <div id="resultContainer" class="display-none">
            <div id="divEPADeductionHistoryGrid" class="freegrid">
            </div>
        </div>
    </div>

    <div id="divErrorHistoryForm" style="min-width: 812px;">
        <div id="resultContainer" class="display-none">
            <div id="divErrorHistoryGrid" class="freegrid">
            </div>
        </div>
    </div>

    <div id="divLeaveHistoryForm" style="min-width: 682px; ">
        <div id="resultContainer" class="display-none">
            <div id="divLeaveHistoryGrid" class="freegrid">
            </div>
        </div>
    </div>
</div>

@section Foot
{
    @Scripts.Render("~/scripts/os-epa-deduction-management")

    <script>
        var datepickerSetting = {
            MinDate: '@(((DateTime)ViewBag.MinDate).ToShortFormatedDate())',
            DefaultFromDate: '@(((DateTime)ViewBag.DefaultFromDate).ToShortFormatedDate())',
            DefaultToDate: '@(((DateTime)ViewBag.DefaultToDate).ToShortFormatedDate())',
            AllowYearRange: parseInt('@ViewBag.AllowYearRange')
        };

        var messages = {
            InsertErrorSuccessfully: '@Messages.InsertErrorSuccessfully',
            InsertEmergencyLeaveSuccessfully: '@Messages.InsertEmergencyLeaveSuccessfully',
            InsertEPADeductionSuccessfully: '@Messages.InsertEPADeductionSuccessfully'
        };
    </script>
}
