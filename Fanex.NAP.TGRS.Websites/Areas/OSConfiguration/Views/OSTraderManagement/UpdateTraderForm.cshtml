<div id="divUpdateTraderForm" class="form-bar width-400">
    <div class="form expand-form">
        <div id="divErrorSuccessMsg" class="inline-message">
        </div>
        <div class="form-row">
            <div class="lbl-field width-120">
                <label>@ViewLang.Username</label>
            </div>
            <div class="edit-field">
                <input type="text" id="txtTraderName" class="width-200 " data-val-required="@Messages.RequiredFieldError" disabled="disabled"/>
                <input type="hidden" id="txtCustId" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-120">
                <label>@ViewLang.EmployeeId</label>
            </div>
            <div class="edit-field">
                <input type="text" id="txtEmployeeId" class="width-200 " data-val-required="@Messages.RequiredFieldError" disabled="disabled"/>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-120">
                <label>@ViewLang.Team</label>
            </div>
            <div class="edit-field">
                <select id="ddlTeamPopup" style="width: 95px">
                </select>
            </div>
            <div id="dpkTeamEffectiveDate">
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-120">
                <label>@ViewLang.Grade</label>
            </div>
            <div class="edit-field">
                <select id="ddlGradePopup" style="width: 95px">
                </select>
            </div>
            <div id="dpkGradeEffectiveDate">
            </div>
        </div>
        <div class="form-row">
            <div id="dpkFirstWorkingDate" style="display: none"></div>
        </div>
        <div class="form-row button-row">
            <div class="lbl-field width-120">
            </div>
            <div class="edit-field">
                <input type="button" id="btnSave" class="blue-button" value="@ViewLang.Submit" />
                <input type="button" id="btnCancel" class="red-button" value="@ViewLang.Cancel" />
            </div>
        </div>
    </div>
</div>