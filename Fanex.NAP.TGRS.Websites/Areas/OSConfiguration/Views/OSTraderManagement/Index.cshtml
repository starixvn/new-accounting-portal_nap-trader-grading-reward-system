@{
    ViewBag.Title = "Trader Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Headline{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>

    @if (ViewBag.HasEditRight)
    {
        <div class="header-button">
            <a href="#" id="lnkAddNewTrader" class="green-button change-list">
                <span class="add-icon">
                </span>@ViewLang.NewTrader
            </a>
        </div>
    }
}

@Html.Partial("IndexFilter")


<div class="display-none">
    @if (ViewBag.HasEditRight)
    {
        @Html.Partial("InsertTraderForm")
        @Html.Partial("UpdateTraderForm")
        @Html.Partial("InsertNewIssueForm")
    }
    <div id="popupGridHistory" class="freegrid" style="width: 410px;"></div>
    <div id="popupGridIssue" class="freegrid" style="min-width: 655px;"></div>
</div>


<div id="resultContainer" class="content-grid">
    <div id="divTradersGrid" class="freegrid">
    </div>
</div>

@section Foot
{
    @Scripts.Render("~/scripts/os-trader-management")
    <script type="text/javascript">
        var labels = {
            UserName: '@ViewLang.Username',
            EmployeeId: '@ViewLang.EmployeeId',
            Team: '@ViewLang.Team',
            Grade: '@ViewLang.Grade',
            CreatedDate: '@ViewLang.CreatedDate',
            CreatedBy: '@ViewLang.CreatedBy',
            NewTrader: '@ViewLang.NewTrader',
            EditTrader: '@ViewLang.EditTrader',
            AllTeams: '@ViewLang.AllTeams',
            AllGrades: '@ViewLang.AllGrades',
            SelectATeam: '@ViewLang.SelectATeam',
            SelectAGrade: '@ViewLang.SelectAGrade',
            EffectiveDate: '@ViewLang.EffectiveDate',
            TeamEffectiveDate: '@ViewLang.TeamEffectiveDate',
            GradeEffectiveDate: '@ViewLang.GradeEffectiveDate',
            GradeHistory: '@ViewLang.GradeHistory',
            TeamHistory: '@ViewLang.TeamHistory',
            EPADeduction: '@ViewLang.EPADeduction',
            Error: '@ViewLang.Issue',
            Date: '@ViewLang.Date',
            FirstWorkingDate: '@ViewLang.FirstWorkingDate',
            NewIssue: '@ViewLang.NewIssue'
        };
        var messages = {
            UpdateTraderSuccessfully: '@Messages.UpdateTraderSuccessfully',
            AddTraderSuccessfully: '@Messages.AddTraderSuccessfully',
            InvalidValueError: '@Messages.InvalidValueError',
            AddIssueSuccessfully: '@Messages.AddIssueSuccesfully',
        };
        var hasEditRight = '@ViewBag.HasEditRight' === 'True';
        var datepickerSetting = {
            Today: '@DateTime.Today.ToShortFormatedDate()'
        };
    </script>
}