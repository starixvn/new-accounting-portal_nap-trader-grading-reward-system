@{
    ViewBag.Title = ViewLang.PerformanceSummaryReport;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div class="filter-bar">
    <div id="divReportFilterForm" class="filter-form">
        <div class="filter-row ">
            <div class="lbl-field col_3">
                <label>@ViewLang.PeriodType</label>
            </div>
            <div class="edit-field">
                <select id="ddlPeriodType" class="col_3">
                    <option value="1" selected>@ViewLang.Date</option>
                    <option value="2">@ViewLang.Month</option>
                    <option value="3">@ViewLang.Year</option>
                </select>
            </div>
            <div id="divDatePair"></div>
            <div class="col_5" id="divFromMonthContainer" ><div id="divFromMonth"></div></div>
            <div class="month_lbl_field lbl-field col_1 align-center"> - </div>
            <div class="col_5" id="divToMonthContainer"><div id="divToMonth"></div></div>
            <div class="edit-field">
                <select id="ddlYear">
                </select>
            </div>
            <div class="submit col_4">
                <input id="btnSearch" type="submit" class="blue-button" value="Search">
            </div>
        </div>
    </div>
</div>
<div id="divReportData">
<div id="divGeneralInfo" class="content-generalInfo display-none">
    <label class="col_4">@ViewLang.LiveTurnover:</label>
    <label class="col_4 align-right" id="lblTurnOver">
    </label>
    <label class="col_4 margin-left-100">   @ViewLang.Margin:</label>
    <label class="col_3 align-right" id="lblMargin">
    </label>
    <br />
    <label class="col_4">@ViewLang.LiveWinLoss:</label>
    <label class="col_4 align-right" id="lblWinLoss">
    </label>
    <label class="col_4 margin-left-100">   @ViewLang.NoOfMatches:</label>
    <label class="col_3 align-right" id="lblMatches">
    </label>
</div>
<div class="content-grid display-none">
    <div id="divTeamGrid" class="freegrid display-none">
    </div>
</div>
<div class="content-grid display-none">
    <div id="divTraderGrid" class="freegrid display-none">
    </div>
</div>
<div class="content-grid display-none">
    <div id="divTopWinLeagueGrid" class="freegrid display-none">
    </div>
</div>
<div class="content-grid display-none">
    <div id="divTopLoseLeagueGrid" class="freegrid display-none">
    </div>
</div>
<div class="content-grid margin-bottom display-none">
    <div id="divBetTypeGrid" class="freegrid display-none">
    </div>
</div>
</div>
@section Foot
{
    @Scripts.Render("~/scripts/performanceSummary")
    <script type="text/javascript">
        var labels = {
            Date: '@ViewLang.Date',
            Team: '@ViewLang.Team',
            League: '@ViewLang.League',
            Turnover: '@ViewLang.Turnover',
            Winloss: '@ViewLang.WinLoss',
            Margin: '@ViewLang.Margin',
            MinMargin: '@ViewLang.MinMargin',
            MaxMargin: '@ViewLang.MaxMargin',
            BetType: '@ViewLang.BetType',
            Top10ByMargin: '@ViewLang.Top10ByMargin',
            Bottom10ByMargin: '@ViewLang.Bottom10ByMargin',
            TraderPerformance: '@ViewLang.TraderPerformance',
            TeamPerformance: '@ViewLang.TeamPerformance',
            Top5WinningLeagues: '@ViewLang.Top5WinningLeagues',
            Top5LosingLeagues: '@ViewLang.Top5LosingLeagues',
            BetTypePerformance: '@ViewLang.BetTypePerformance',
            NA: '@ViewLang.NA'
        };
        var yearOptions = {
            maxYearRange : @ViewBag.PerformanceYearRange,
            maxYearRangeSelect : @ViewBag.PerformanceAllowYearRange
        }
    </script>
}
