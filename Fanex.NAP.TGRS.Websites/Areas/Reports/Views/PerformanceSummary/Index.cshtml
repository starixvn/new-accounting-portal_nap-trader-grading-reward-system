@{
    ViewBag.Title = ViewLang.PerformanceSummaryReport;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div class="filter-bar">
    <div id="divReportFilterForm" class="filter-form" style="float: left !important;">
        <div class="filter-row width-800">
            <div class="lbl-field col_3">
                <label>@ViewLang.PeriodType</label>
            </div>
            <div class="edit-field">
                <select id="ddlPeriodType">
                    <option value="1">Date</option>
                    <option value="2">Month</option>
                    <option value="3">Year</option>
                </select>
            </div>
            <div id="dpkFromDate">
            </div>
            <div id="dpkToDate">
            </div>
            <div id="dpkFromMonth">
            </div>
            <div id="dpkToMonth">
            </div>
            <div class="edit-field col_3 display-none">
                <div class="lbl-field col_2">
                    <label>
                    </label>
                </div>
                <select id="ddlYear">
                </select>
            </div>
            <div class="submit col_4">
                <input id="btnSearch" type="submit" class="blue-button float-right" value="Search">
            </div>
        </div>
    </div>
</div>
<div id="divGeneralInfo" class="content-generalInfo display-none">
    <label class="col_4">@ViewLang.LiveWinLoss:</label>
    <label class="col_7" id="lblWinLoss">
    </label>
    <label class="col_4">@ViewLang.Margin:</label>
    <label class="col_7" id="lblMargin">
    </label>
    <br />
    <label class="col_4">@ViewLang.LiveTurnover:</label>
    <label class="col_7" id="lblTurnOver">
    </label>
    <label class="col_4">@ViewLang.NoOfMatches:</label>
    <label class="col_7" id="lblMatches">
    </label>
</div>
<div class="content-grid display-none">
    <div id="divTeamGrid" class="freegrid display-none">
    </div>
</div>
<div class="content-grid display-none">
    <div id="divTraderGrid" class="freegrid display-none">
    </div>
</div>
<div class="content-grid display-none">
    <div id="divTopWinLeagueGrid" class="freegrid display-none">
    </div>
</div>
<div class="content-grid display-none">
    <div id="divTopLoseLeagueGrid" class="freegrid display-none">
    </div>
</div>
<div class="content-grid margin-bottom display-none">
    <div id="divBetTypeGrid" class="freegrid display-none">
    </div>
</div>
@section Foot
{
    @Scripts.Render("~/scripts/performanceSummary")
    <script type="text/javascript">
        var labels = {
            Date: '@ViewLang.Date',
            Team: '@ViewLang.Team',
            League: '@ViewLang.League',
            Turnover: '@ViewLang.Turnover',
            Winloss: '@ViewLang.WinLoss',
            Margin: '@ViewLang.Margin',
            BetType: '@ViewLang.BetType',
            Top10ByMargin: '@ViewLang.Top10ByMargin',
            Bottom10ByMargin: '@ViewLang.Bottom10ByMargin',
            TraderPerformance: '@ViewLang.TraderPerformance',
            TeamPerformance: '@ViewLang.TeamPerformance',
            Top5WinLeague: '@ViewLang.Top5WinLeague',
            Top5LoseLeague: '@ViewLang.Top5LoseLeague',
            BetTypePerformance: '@ViewLang.BetTypePerformance',
            NA: '@ViewLang.NA'
        };
        function resolveClientUrl(relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        }
    </script>
}
