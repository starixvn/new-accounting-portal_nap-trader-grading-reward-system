@using Fanex.NAP.TGRS.Reports.ViewModels.PerformanceDetail
@{
    ViewBag.Title = ViewLang.PerformanceDetailReport;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
    @Styles.Render("~/styles/performanceDetail")
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
    <div class="header-button">
        <a href="@Url.Content("/Reports/PerformanceDetail/LeaguePerformance")" class="green-button change-list">
            <span class="list-icon"></span>@ViewLang.League
        </a>
        <a href="@Url.Content("/Reports/PerformanceDetail/TraderPerformance")" class="green-button change-list">
            <span class="list-icon"></span>@ViewLang.Trader
        </a>
        <a href="@Url.Content("/Reports/PerformanceDetail/GradePerformance")" class="green-button change-list">
            <span class="list-icon"></span>@ViewLang.Grade
        </a>
        <a href="#" class="green-button change-list disabled">
            <span class="list-icon"></span>@ViewLang.Team
        </a>
        <a href="@Url.Content("/Reports/PerformanceDetail/BetTypePerformance")" class="green-button change-list">
            <span class="list-icon"></span>@ViewLang.BetType
        </a>
    </div>
}
<div class="filter-bar">
    <div id="divTeamPerformanceFilter" class="filter-form">
        <div class="filter-row">
            <div id="divDateRange"></div>
        </div>
        <div class="filter-row">
            <div class="lbl-field col_3 align-right">
                <label for="ddlBetType">@ViewLang.BetType</label>
            </div>
            <div class="edit-field col_9 align-left">
                <select id="ddlBetType" multiple="multiple">
                    @foreach (var item in (IEnumerable<BetTypeItem>)ViewBag.BetTypes)
                    {
                        <option value="@item.BetTypeId">@item.BetTypeName</option>
                    }
                </select>
            </div>
            <div class="lbl-field col_3 align-right">
                <label for="txtMarginFrom">@ViewLang.Margin</label>
            </div>
            <div class="edit-field col_6 align-left">
                <input type="text" id="txtMarginFrom" class="width-60" maxlength="5" data-val-number="@Messages.InvalidValueError" />
                <span> - </span>
                <input type="text" id="txtMarginTo"  class="width-60" maxlength="5" data-val-number="@Messages.InvalidValueError" />
            </div>
            <div class="lbl-field col_5 align-right">
                <label for="txtMinTurnover">@ViewLang.MinimumTurnover</label>
            </div>
            <div class="edit-field col_5 align-left">
                <input type="text" id="txtMinTurnover" maxlength="10" data-val-number="@Messages.InvalidValueError" />
            </div>
            <div class="lbl-field col_5 align-right">
                <label for="txtMinWinLoss">@ViewLang.MinimumWinLoss</label>
            </div>
            <div class="edit-field col_5 align-left">
                <input type="text" id="txtMinWinLoss" maxlength="10" data-val-number="@Messages.InvalidValueError" />
            </div>
        </div>
        <div class="filter-row">
            <div class="lbl-field col_3 align-right">
                <label for="ddlTeam">@ViewLang.Team</label>
            </div>
            <div class="edit-field col_9 align-left">
                <select id="ddlTeam" multiple="multiple">
                    @foreach (var item in (IEnumerable<TeamItem>)ViewBag.Teams)
                    {
                        <option value="@item.TeamId">@item.TeamName</option>
                    }
                </select>
            </div>
            <div class="lbl-field col_3 align-right">
                <label for="txtTeamBMFrom">@ViewLang.TeamBM</label>
            </div>
            <div class="edit-field col_6 align-left">
                <input type="text" id="txtTeamBMFrom" class="width-60" maxlength="5" data-val-number="@Messages.InvalidValueError" />
                <span> - </span>
                <input type="text" id="txtTeamBMTo" class="width-60" maxlength="5" data-val-number="@Messages.InvalidValueError" />
            </div>
            <div class="submit col_4">
                <input id="btnGenerate" type="button" class="blue-button generate" value="@ViewLang.Generate" />
            </div>
        </div>
    </div>
</div>
<div id="divTeamPerformanceContainer" class="content-grid display-none">
    <div id="divTeamPerformanceGrid" class="freegrid"></div>
</div>
<div id="divTraderPerformanceContainer" class="content-grid display-none">
    <div id="divTraderPerformanceGrid" class="freegrid"></div>
</div>
<div id="divMatchPerformanceContainer" class="content-grid display-none">
    <div id="divMatchPerformanceGrid" class="freegrid"></div>
</div>
@section Foot
{
    @Scripts.Render("~/scripts/teamPerformance")
    <script type="text/javascript">
        var datepickerSetting = {
            MinDate: '@(((DateTime)ViewBag.MinDate).ToShortFormatedDate())',
            DefaultFromDate: '@(((DateTime)ViewBag.DefaultFromDate).ToShortFormatedDate())',
            DefaultToDate: '@(((DateTime)ViewBag.DefaultToDate).ToShortFormatedDate())',
            AllowYearRange: parseInt('@ViewBag.AllowYearRange')
        };
        var labels = {
            No: '#',
            NoOfLeagues: '@ViewLang.NoOfLeagues',
            NoOfTraders: '@ViewLang.NoOfTraders',
            NoOfMatches: '@ViewLang.NoOfMatches',
            Turnover: '@ViewLang.Turnover',
            WinLoss: '@ViewLang.WinLoss',
            BetCount: '@ViewLang.BetCount',
            Margin: '@ViewLang.Margin',
            TeamBM: '@ViewLang.TeamBM',
            Trader: '@ViewLang.Trader',
            Grade: '@ViewLang.Grade',
            Team: '@ViewLang.Team',
            Match: '@ViewLang.Match',
            Total: '@ViewLang.Total',
            GrandTotal: '@ViewLang.GrandTotal',
            AllBetTypes: '@ViewLang.AllBetTypes',
            AllTeams: '@ViewLang.AllTeams',
            EventDate: '@ViewLang.EventDate',
            EffectiveDate: '@ViewLang.EffectiveDate',
            NA: '@ViewLang.NA',
            Forecast: '@ViewLang.Forecast',
            TeamPerformance: '@ViewLang.TeamPerformance',
            TraderPerformance: '@ViewLang.TraderPerformance',
            MatchPerformance: '@ViewLang.MatchPerformance',
            TeamHistoryDetail: '@ViewLang.TeamHistoryDetail',
            GradeHistoryDetail: '@ViewLang.GradeHistoryDetail'
        };
        var messages = {
            InvalidValue: '@Messages.InvalidValueError'
        };
    </script>
}