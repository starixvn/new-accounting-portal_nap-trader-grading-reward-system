@using Fanex.NAP.TGRS.Reports.ViewModels.MultipleMatchesPerformance
@{
    ViewBag.Title = ViewLang.MultipleMatchesPerformance;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
    @Styles.Render("~/styles/multipleMatchesTraderPerformance")
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
    <div class="header-button">
        @*<a href="@Url.Content("~/Reports/MultipleMatchesPerformance/TraderPerformance")" class="green-button change-list">
            <span class="list-icon"></span>@ViewLang.Summary
        </a>*@
        <a href="#" class="green-button change-list disabled">
            <span class="list-icon"></span>@ViewLang.Trader
        </a>
        @*<a href="@Url.Content("~/Reports/MultipleMatchesPerformance/TraderPerformance")" class="green-button change-list">
            <span class="list-icon"></span>@ViewLang.Grade
        </a>
        <a href="@Url.Content("~/Reports/MultipleMatchesPerformance/TraderPerformance")" class="green-button change-list">
            <span class="list-icon"></span>@ViewLang.Shift
        </a>*@
    </div>
}

<div class="filter-bar">
    <div id="divTraderPerformanceFilter" class="filter-form">
        <div class="filter-row">
            <div class="date-range"><div id="divDateRange"></div></div>
            <div class="lbl-field col_5">
                <label>@ViewLang.Grade</label>
            </div>
            <div class="edit-field col_8">
                <select id="ddlGrade" multiple="multiple">
                    @for (int i = 1; i < 11; i++)
                    {
                        <option value=@i>@i</option>
                    }
                    <option value=200>200</option>
                </select>
            </div>
            <div class="lbl-field col_5">
                <label>@ViewLang.Team</label>
            </div>
            <div class="edit-field col_8">
                <select id="ddlTeam" multiple="multiple">
                    @foreach (var item in (IEnumerable<TeamItem>)ViewBag.Teams)
                    {
                        <option value="@item.TeamId">@item.TeamName</option>
                    }
                </select>
            </div>
        </div>
        <div class="filter-row">
            <div class="lbl-field col_5">
                <label>@ViewLang.BetType</label>
            </div>
            <div class="edit-field col_9">
                <select id="ddlBetType" multiple="multiple">
                    <option value="1">1st HDP</option>
                    <option value="3">1st O/U</option>
                    <option value="7">HDP</option>
                    <option value="8">O/U</option>
                </select>
            </div>
            <div class="lbl-field col_5">
                <label>@ViewLang.MultipleMatches</label>
            </div>
            <div class="edit-field col_8">
                <select id="ddlMultipleMatches" multiple="multiple">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5,6,7,8,9,10">>=5</option>
                </select>
            </div>
            <div class="submit col_5">
                <input id="btnGenerate" type="button" class="blue-button trader-generate" value="@ViewLang.Generate" />
            </div>
        </div>
    </div>
</div>
<div id="divTraderPerformanceContainer" class="content-grid display-none">
    <div id="divTraderPerformanceGrid" class="freegrid"></div>
</div>
<div id="divMatchPerformanceContainer" class="content-grid display-none">
    <div id="divMatchPerformanceGrid" class="freegrid"></div>
</div>
<div id="divBettypeDetailContainer" class="content-grid display-none">
    <div id="divBettypeDetailGrid" class="freegrid"></div>
</div>
@section Foot
{
    @Scripts.Render("~/scripts/multipleMatchesTraderPerformance")
    <script type="text/javascript">
        var datepickerSetting = {
            MinDate: '@(((DateTime)ViewBag.MinDate).ToShortFormatedDate())',
            DefaultFromDate: '@(((DateTime)ViewBag.DefaultFromDate).ToShortFormatedDate())',
            DefaultToDate: '@(((DateTime)ViewBag.DefaultToDate).ToShortFormatedDate())',
            AllowYearRange: parseInt('@ViewBag.AllowYearRange')
        };
        var forecastBettype = '@ViewBag.ForecastBetType';
        var labels = {
            No: '#',
            NoOfMatches: '@ViewLang.NoOfMatches',
            Turnover: '@ViewLang.Turnover',
            WinLoss: '@ViewLang.WinLoss',
            BetCount: '@ViewLang.BetCount',
            BetTypeBM: '@ViewLang.BetTypeBM',
            BetType: '@ViewLang.BetType',
            BetTypeDetail: '@ViewLang.BetTypeDetail',
            Margin: '@ViewLang.Margin',
            Trader: '@ViewLang.Trader',
            Grade: '@ViewLang.Grade',
            Team: '@ViewLang.Team',
            Match: '@ViewLang.Match',
            Total: '@ViewLang.Total',
            GrandTotal: '@ViewLang.GrandTotal',
            All: '@ViewLang.All',
            EventDate: '@ViewLang.EventDate',
            EffectiveDate: '@ViewLang.EffectiveDate',
            NA: '@ViewLang.NA',
            Forecast: '@ViewLang.Forecast',
            TraderPerformance: '@ViewLang.TraderPerformance',
            MatchPerformance: '@ViewLang.MatchPerformance',
            MultipleMatches: '@ViewLang.MultipleMatches',
            MultipleMatchesPerformance: '@ViewLang.MultipleMatchesPerformance'
        };
      var messages = {
          InvalidValue: '@Messages.InvalidValueError',
          RequiredField: '@Messages.RequiredFieldError'
      };
    </script>
}