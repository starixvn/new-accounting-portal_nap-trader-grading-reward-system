@using Fanex.NAP.TGRS.Reports.ViewModels.PerformanceDetail
@{
    ViewBag.Title = ViewLang.ActualRatePerformanceDetailReport;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
    @Styles.Render("~/styles/performanceDetail")
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
    <div class="header-button">
        <a href="#" class="green-button change-list disabled">
            <span class="list-icon"></span>@ViewLang.League
        </a>
        <a href="@Url.Content("~/Reports/ActualRatePerformanceDetail/TraderPerformance")" class="green-button change-list">
            <span class="list-icon"></span>@ViewLang.Trader
        </a>
        <a href="@Url.Content("~/Reports/ActualRatePerformanceDetail/GradePerformance")" class="green-button change-list">
            <span class="list-icon"></span>@ViewLang.Grade
        </a>  
        <a href="@Url.Content("~/Reports/ActualRatePerformanceDetail/TeamPerformance")" class="green-button change-list">
            <span class="list-icon"></span>@ViewLang.Team
        </a>       
    </div>    
}
<div class="filter-bar">
    <div id="divLeaguePerformanceFilter" class="filter-form">
        <div class="filter-row">
            <div class="date-range"><div id="divDateRange"></div></div>
            <div class="lbl-field col_2">
                <label for="txtLeague">@ViewLang.League</label>
            </div>
            <div class="edit-field col_8">
                <input type="text" id="txtLeague" class="league" maxlength="100" />
            </div>
            <div class="col_1">
                <input id="btnGenerate" type="button" class="blue-button" value="@ViewLang.Generate" />
            </div>
        </div>
    </div>
</div>
<div id="divLeaguePerformanceContainer" class="content-grid display-none">
    <div id="divLeaguePerformanceGrid" class="freegrid"></div>
</div>
<div id="divTraderPerformanceContainer" class="content-grid display-none">
    <div id="divTraderPerformanceGrid" class="freegrid"></div>
</div>
<div id="divMatchPerformanceContainer" class="content-grid display-none">
    <div id="divMatchPerformanceGrid" class="freegrid"></div>
</div>
<div id="divBettypeDetailContainer" class="content-grid display-none">
    <div id="divBettypeDetailGrid" class="freegrid"></div>
</div>
<div id="divMatchPerformanceOfLeagueContainer" class="content-grid display-none">
    <div id="divMatchPerformanceOfLeagueGrid" class="freegrid"></div>
</div>
<div id="divBettypePerformanceOfLeagueMatchContainer" class="content-grid display-none">
    <div id="divBettypePerformanceOfLeagueMatchGrid" class="freegrid"></div>
</div>
@section Foot
{
    <script type="text/javascript" src="~/Areas/Reports/Resources/ActualRatePerformanceDetail/league-performance.js"></script>
    <script type="text/javascript">
        var datepickerSetting = {
            MinDate: '@(((DateTime)ViewBag.MinDate).ToShortFormatedDate())',
            DefaultFromDate: '@(((DateTime)ViewBag.DefaultFromDate).ToShortFormatedDate())',
            DefaultToDate: '@(((DateTime)ViewBag.DefaultToDate).ToShortFormatedDate())',
            AllowYearRange: parseInt('@ViewBag.AllowYearRange')
        };
        var forecastBettype = '@ViewBag.ForecastBetType';
        var labels = {
            No: '#',
            League: '@ViewLang.League',
            NoOfTraders: '@ViewLang.NoOfTraders',
            NoOfMatches: '@ViewLang.NoOfMatches',
            Turnover: '@ViewLang.TurnoverMY',
            WinLoss: '@ViewLang.WinLoss',
            Juice: '@ViewLang.Juice',
            Leftover: '@ViewLang.Leftover',
            Total: '@ViewLang.Total',
            EventDate: '@ViewLang.EventDate',
            BetCount: '@ViewLang.BetCount',
            Margin: '@ViewLang.Margin',
            MarginTotal: '@ViewLang.MarginTotal',
            LeagueBM: '@ViewLang.LeagueBM',
            BetTypeBM: '@ViewLang.BetTypeBM',
            BetType: '@ViewLang.BetType',
            BetTypeDetail: '@ViewLang.BetTypeDetail',
            Trader: '@ViewLang.Trader',
            Grade: '@ViewLang.Grade',
            Team: '@ViewLang.Team',
            Match: '@ViewLang.Match',
            Total: '@ViewLang.Total',
            GrandTotal: '@ViewLang.GrandTotal',
            AllBetTypes: '@ViewLang.AllBetTypes',
            NA: '@ViewLang.NA',
            Forecast: '@ViewLang.Forecast',
            EffectiveDate: '@ViewLang.EffectiveDate',
            LeaguePerformance: '@ViewLang.LeaguePerformance',
            TraderPerformance: '@ViewLang.TraderPerformance',
            MatchPerformance: '@ViewLang.MatchPerformance',
            TeamHistoryDetail: '@ViewLang.TeamHistoryDetail',
            GradeHistoryDetail: '@ViewLang.GradeHistoryDetail',
            Score: '@ViewLang.Score',
            Benchmark: '@ViewLang.BM',
            ScoreByLatestBenchMark: '@ViewLang.ScoreByLatestBenchMark',
            ScoreByPeriod: '@ViewLang.ScoreByPeriod'
        };
        var messages = {
            InvalidValue: '@Messages.InvalidValueError',
            RequiredField: '@Messages.RequiredFieldError'
        };
    </script>
}