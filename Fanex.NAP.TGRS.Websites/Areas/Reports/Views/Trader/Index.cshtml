@{
    ViewBag.Title = ViewLang.TraderReport;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Styles.Render("~/styles/trader")
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div class="filter-bar">
    <div id="divReportFilterForm" class="filter-form">
        <div class="filter-row ">
            <div id="divDateRange">
            </div>
            <div class="submit col_4">
                <input id="btnSearch" type="submit" class="blue-button" value="Search">
            </div>
        </div>
    </div>
</div>
<div id="divReportData">
    <fieldset>
        <div id="switchChartFigure" class="switch-toggle-figure">
            @if (ViewBag.IsVirtualPerformancePermission && ViewBag.IsRealPerformancePermission)
            {
                <input id="chkVirtualFigure" type="radio" name="Figure" value="Virtual">
                <label for="Virtual" id="lblVirtualFigure">Virtual</label>

                <input id="chkRealFigure" type="radio" name="Figure" value="Real" checked>
                <label for="Real" id="lblRealFigure">Real</label>
            }          
        </div>
    </fieldset>

    <div id="divGeneralInfo" class="content-general-info display-none">
        <div class="info-cell-1">
            <label class="title" id="titleTurnOver">@ViewLang.LiveTurnover</label>
            <label class="number" id="lblTurnOver">
            </label>
        </div>
        <div class="info-cell-1">
            <label class="title" id="titleWinLoss">@ViewLang.LiveWinLoss</label>
            <label class="number" id="lblWinLoss">
            </label>
        </div>
        <div class="info-cell-1">
            <label class="title" id="titleMargin">@ViewLang.MarginSummary</label>
            <label class="number" id="lblMargin">
            </label>
        </div>
        <div class="info-cell-1">
            <label class="title">
                @ViewLang.NoOfMatches
            </label>
            <label class="number" id="lblMatches">
            </label>
        </div>
    </div>
    <div id="divTopTrader" class="info-cell-2-left display-none">
        <div id="teamWinlossContainer" class="chart-container">
        </div>
        <div id="switchChart" class="switch-toggle switch-ios flat-switch">
            <input id="chkMonth" name="chartType" type="radio">
            <label for="chkMonth">Month</label>

            <input id="chkDay" name="chartType" type="radio" checked="">
            <label for="chkDay">Day</label>

            <a id="toggleA"></a>
        </div>
    </div>

    <div class="content-grid display-none">
        <div id="divBettypePerformanceGrid" class="freegrid display-none">
        </div>
    </div>
    <div id="LeaguesPerformanceContainer" class="content-grid margin-bottom display-none">
        <div id="divLeaguesPerformanceGrid" class="freegrid display-none">
        </div>
    </div>
    <div id="MatchesPerformanceContainer" class="content-grid margin-bottom display-none">
        <div id="divMatchesPerformanceGrid" class="freegrid display-none">
        </div>
    </div>
    <div id="BettypesPerformanceContainer" class="content-grid margin-bottom display-none">
        <div id="divBettypesPerformanceGrid" class="freegrid display-none">
        </div>
    </div>
</div>
@section Foot
{
    @Scripts.Render("~/scripts/trader")
<script type="text/javascript">
        var labels = {
            Date: '@ViewLang.Date',
            Team: '@ViewLang.Team',
            League: '@ViewLang.League',
            Match: '@ViewLang.Match',
            Turnover: '@ViewLang.Turnover',
            WinLoss: '@ViewLang.WinLoss',
            Margin: '@ViewLang.Margin',
            MinMargin: '@ViewLang.MinMargin',
            MaxMargin: '@ViewLang.MaxMargin',
            BetType: '@ViewLang.BetType',
            BetTypePerformance: '@ViewLang.BetTypePerformance',
            NA: '@ViewLang.NA',
            LeaguesPerformance: '@ViewLang.LeaguePerformance',
            BetCount: '@ViewLang.BetCount',
            No: '#',
            NoOfMatches: '@ViewLang.NoOfMatches',
            MatchPerformance: '@ViewLang.MatchPerformance',
            GrandTotal: '@ViewLang.GrandTotal'
        };
        var datepickerSetting = {
            MinDate: '@(((DateTime)ViewBag.MinDate).ToShortFormatedDate())',
            DefaultFromDate: '@(((DateTime)ViewBag.DefaultFromDate).ToShortFormatedDate())',
            DefaultToDate: '@(((DateTime)ViewBag.DefaultToDate).ToShortFormatedDate())',
            AllowYearRange: parseInt('@ViewBag.AllowYearRange')
        };

        var isVirtualPerformancePermission = '@ViewBag.IsVirtualPerformancePermission' == "True";
        var isRealPerformancePermission = '@ViewBag.IsRealPerformancePermission' == "True";
</script>
}