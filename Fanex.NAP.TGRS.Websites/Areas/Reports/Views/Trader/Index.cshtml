@{
    ViewBag.Title = ViewLang.TraderReport;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Styles.Render("~/styles/trader")
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div class="filter-bar">
    <div id="divReportFilterForm" class="filter-form">
        <div class="filter-row ">
            <div id="divDateRange">
            </div>
            <div class="submit col_4">
                <input id="btnSearch" type="submit" class="blue-button" value="Search">
            </div>
        </div>
    </div>
</div>
<div id="divReportData">
    <div id="divGeneralInfo" class="content-general-info display-none">
        <div class="info-cell-1">
            <label class="title">@ViewLang.LiveTurnover</label>
            <label class="number" id="lblTurnOver">
            </label>
        </div>
        <div class="info-cell-1">
            <label class="title">@ViewLang.LiveWinLoss</label>
            <label class="number" id="lblWinLoss">
            </label>
        </div>
        <div class="info-cell-1">
            <label class="title">@ViewLang.MarginSummary</label>
            <label class="number" id="lblMargin">
            </label>
        </div>
        <div class="info-cell-1">
            <label class="title">
                @ViewLang.NoOfMatches
            </label>
            <label class="number" id="lblMatches">
            </label>
        </div>
    </div>
    @*display-none*@
    <div id="divTraderPerformance" class="content-general-info">
        <div id="divTopTrader" class="">
            <div id="teamWinlossContainer" class="chart-container">
            </div>
        </div>
    </div>
    <div class="content-grid display-none">
        <div id="divTraderGrid" class="freegrid display-none">
        </div>
    </div>
    <div class="content-grid display-none">
        <div id="divTeamGrid" class="freegrid display-none">
        </div>
    </div>
    <div class="content-grid display-none">
        <div id="divTopWinLeagueGrid" class="freegrid display-none">
        </div>
    </div>
    <div class="content-grid display-none">
        <div id="divTopLoseLeagueGrid" class="freegrid display-none">
        </div>
    </div>
    <div class="content-grid margin-bottom display-none">
        <div id="divBetTypeGrid" class="freegrid display-none">
        </div>
    </div>
</div>
@section Foot
{
    @Scripts.Render("~/scripts/trader")
    <script type="text/javascript">
        var labels = {
            Date: '@ViewLang.Date',
            Team: '@ViewLang.Team',
            League: '@ViewLang.League',
            Turnover: '@ViewLang.Turnover',
            WinLoss: '@ViewLang.WinLoss',
            Margin: '@ViewLang.Margin',
            MinMargin: '@ViewLang.MinMargin',
            MaxMargin: '@ViewLang.MaxMargin',
            BetType: '@ViewLang.BetType',
            Bottom10ByMargin: '@ViewLang.Bottom10ByMargin',
            TraderPerformance: '@ViewLang.TraderPerformance',
            TeamPerformance: '@ViewLang.TeamPerformance',
            BetTypePerformance: '@ViewLang.BetTypePerformance',
            NA: '@ViewLang.NA'
        };
        var datepickerSetting = {
            MinDate: '@(((DateTime)ViewBag.MinDate).ToShortFormatedDate())',
            DefaultFromDate: '@(((DateTime)ViewBag.DefaultFromDate).ToShortFormatedDate())',
            DefaultToDate: '@(((DateTime)ViewBag.DefaultToDate).ToShortFormatedDate())',
            AllowYearRange: parseInt('@ViewBag.AllowYearRange')
        };
    </script>
}