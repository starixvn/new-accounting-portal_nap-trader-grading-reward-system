@using Fanex.NAP.TGRS.Reports.Models.TraderPerformanceMonthly
@model IEnumerable<Fanex.NAP.TGRS.Reports.Models.TraderPerformanceMonthly.Shift>

    @{
        ViewBag.Title = ViewLang.TraderMonthlyPerformance;
        Layout = "~/Views/Shared/_Layout.cshtml";
        var traderColumns = Trader.Columns.ToString();
        var avgColumns = AvgSummary.Columns.ToString();
        var monthColumns = Summary.Columns.ToString();
    }

    @section Headline
{
        <style>
            .freegrid .grid-fixed-table tr.shift-summary td {
                background: #FEE4D7;
            }

            .grid-title .btnExcel {
                position: relative !important;
                display: inline-block !important;
                float: right;
                margin-top: 2px;
                margin-left: 0px;
                padding-left: 0px;
            }

            .grid-title .icon-related {
                position: relative;
                display: inline-block;
                margin-top: -1px;
            }

            .icon {
                background-image: url(/Content/Site/images/sprite.png);
                cursor: pointer;
                display: inline-block;
                width: 16px;
                height: 20px;
            }

            .grid-title .menu-column {
                background-color: #fff;
                box-shadow: 0 0 1rem rgba(0,0,0,.1);
                min-width: 100px;
                max-height: 500px;
                overflow: auto;
                padding: 5px 10px;
                position: absolute;
                right: 12px;
                top: 202px;
                z-index: 999;
            }

                .grid-title .menu-column .form-group {
                    margin-bottom: 5px;
                }

            #idShowHideColumns {
                float: left;
                width: 20px;
            }
        </style>
        <div class="title">
            <div>
                <span class="curr">@ViewBag.Title</span>
            </div>
        </div>
    }

    @Html.Partial("Filter")

    <div class="content-grid display-none">
        <div id="table" class="freegrid">
        </div>
    </div>

    @section Foot{
        <script>
            var columns =
                {
                    trader: @Html.Raw(traderColumns),
                    avg: @Html.Raw(avgColumns),
                    month: @Html.Raw(monthColumns)
                    };

            var labels =
                {
                    FstHalf: "Half Year 1 to 6",
                    SndHalf: "Half Year 7 to 12",
                    ThisYear: "YR {0} Up To Date".format(@DateTime.Today.Year),
                    LastYear: "Year {0}".format(@DateTime.Today.Year - 1),
                    Month: '@(string.Format("{{0}} - {0}", DateTime.Today.Year % 100))',
                    Overall: "@ViewLang.Total"
                }
        </script>
        @Scripts.Render("~/scripts/traderPerformanceMonthly")
    }
