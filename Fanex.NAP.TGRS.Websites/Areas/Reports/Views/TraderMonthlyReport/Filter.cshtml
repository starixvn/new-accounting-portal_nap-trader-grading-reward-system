@using Fanex.NAP.TGRS.Reports.Models.TraderPerformanceMonthly
@using Fanex.NAP.TGRS.Reports
@using System.Linq

<div class="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="lbl-field col_3">
                <label for="yearSelector">Year</label>
            </div>
            <div class="edit-field col_6">
                <select id="yearSelector">
                    @for (var year = DateTime.Now.Year; year >= 2015; year--)
                    {
                        if (year < DateTime.Now.Year)
                        {
                            <option value="@((int) year)">@year</option>
                        }
                        else
                        {
                            <option value="@((int) year)" selected>@year</option>
                        }
                    }
                </select>
            </div>

            <div class="lbl-field col_3">
                <label for="bettypeSelector">Product</label>
            </div>
            <div class="edit-field col_5">
                <select id="bettypeSelector">
                    @foreach (var bettype in Enum.GetValues(typeof(Bettype)).Cast<Bettype>().OrderBy(s => (int)s))
                    {
                        <option value="@((int) bettype)">@bettype.GetString()</option>
                    }
                </select>
            </div>

            <div class="lbl-field col_4">
                <label for="shiftSelector">Shift</label>
            </div>
            <div class="edit-field col_5">
                <select id="shiftSelector">
                    <option value="-1">All</option>
                    @foreach (var shift in Model)
                    {
                        <option value="@shift.ShiftId">@shift.ShiftName</option>
                    }
                </select>
            </div>

            <div class="lbl-field col_4">
                <label for="leagueSearch">@ViewLang.League</label>
            </div>
            <div class="edit-field col_8">
                <input id="leagueSearch" type="text" style="width:200px;" maxlength="500" />
            </div>
        </div>

        <div class="filter-row">
            <div class="lbl-field col_3">
                <label for="gradeSelector">Grade</label>
            </div>
            <div class="edit-field col_6">
                <select id="gradeSelector">
                    <option value="-1">All</option>
                    @for (var grade = 1; grade < 11; grade++)
                    {
                        <option value="@grade">@grade</option>
                    }
                    <option value="200">200</option>
                </select>
            </div>

            <div class="lbl-field col_3">
                <label for="traderSearch">@ViewLang.Trader</label>
            </div>
            <div class="edit-field col_5">
                <input id="traderSearch" type="text" style="width:150px;" />
            </div>

            <div class="lbl-field col_4">
                <label for="idColumns">Columns</label>
            </div>
            <div class="edit-field col_5">
                <select multiple="multiple" id="idColumns" style="width:150px;">
                    <option value="7" data-default="1">1st Half Year</option>
                    <option value="14">2nd Half Year</option>
                    <option value="21">Full Year</option>
                    <option value="28">Previous Year</option>
                    <option value="35">January</option>
                    <option value="40">February</option>
                    <option value="45">March</option>
                    <option value="50">April</option>
                    <option value="55">May</option>
                    <option value="60">June</option>
                    <option value="65">July</option>
                    <option value="70">August</option>
                    <option value="75">September</option>
                    <option value="80">October</option>
                    <option value="85">November</option>
                    <option value="90">December</option>
                </select>
            </div>

            <div class="lbl-field col_4">
                <label for="blankSelector"></label>
            </div>
            <div class="submit col_5">
                <input id="btnGenerate" type="button" class="blue-button" value="@ViewLang.Generate" />
            </div>
        </div>

    </div>
</div>