@{
    ViewBag.Title = ViewLang.TraderMonthlyPerformance;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>

    <div class="header-button">
        <a href="@Url.Content("~/Reports/TraderMonthlyReport")" class="green-button change-list">
            <span class="list-icon"></span>@ViewLang.Shift
        </a>
        <a href="#" class="green-button change-list disabled">
            <span class="list-icon"></span>@ViewLang.Week
        </a>
    </div>
}

@Html.Partial("WeekPerformanceFilter")

@section Foot{
    @Scripts.Render("~/scripts/traderPerformanceMonthlyByWeek")
}
