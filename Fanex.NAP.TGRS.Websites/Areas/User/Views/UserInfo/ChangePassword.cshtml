@*@using Fanex.NAP.Core.Criteria.User*@
@*@using Fanex.NAP.TGRS.Core.Resources
@model UpdatePasswordCustCriteria
@{
    bool success = ViewBag.Success != null && ViewBag.Success;
    string message = ViewBag.Message != null ? ViewBag.Message : string.Empty;

    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = ViewResources.Change_Password;
}
@section Headline {
    <div class="title">
        <div>
            <span>@HttpContext.Current.User.Identity.Name / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
@using (Html.BeginForm())
{
    <input type ="hidden" id="hdnToken" name="token" value="@ViewBag.ChangePasswordToken" />
    <div class="form-bar" id="divChangePassword">
        <div class="form">
            <div id="divErrorSuccessMsg" class="inline-message"></div>
            <div class="form-row">
                <div class="lbl-field">
                    <label for="txtOldPassword">@ViewResources.Old_Password</label>
                </div>
                <div class="edit-field">
                    <input type="password" 
                           id="txtOldPassword"
                           class="width-200"
                           data-val-required="@Messages.RequiredFieldError"
                           data-val-length="@Messages.PasswordMinLengthError"
                           data-min-length="5"/>
                    <input type="hidden" id="hdnOldPassword" name="OldUserPwd" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field">
                    <label for="txtNewPassword">@ViewResources.New_Password</label>
                </div>
                <div class="edit-field">
                    <input type="password" 
                           id="txtNewPassword"
                           class="width-200"
                           data-val-required="@Messages.RequiredFieldError"
                           data-val-length="@Messages.PasswordMinLengthError"
                           data-min-length="5"/>
                    <input type="hidden" id="hdnNewPassword" name="UserPwd" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field">
                    <label for="txtConfirmPassword">@ViewResources.Confirm_Password</label>
                </div>
                <div class="edit-field">
                    <input type="password" 
                           id="txtConfirmPassword"
                           class="width-200"
                           data-val-required="@Messages.RequiredFieldError"
                           data-val-length="@Messages.PasswordMinLengthError"
                           data-min-length="5"/>
                    <input type="hidden" id="hdnConfirmPassword" name="ConfirmUserPwd" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field">
                </div>
                <div class="edit-field">
                    <input type="submit" id="btnSave" value="@ViewResources.Save" class="blue-button" />
                    <input type="button" id="btnCancel" value="@ViewResources.Cancel" class="red-button" />
                </div>
            </div>
        </div>
    </div>
}
@section Foot {
    @Scripts.Render("~/scripts/changePassword")
    <script type="text/javascript">
        var passedData = {
            IsSuccess: '@success' === 'True',
            ChangedPasswordSuccessfully: '@ViewResources.Your_changes_were_saved!',
            ErrorMessage: '@message'
        };
    </script>
}*@