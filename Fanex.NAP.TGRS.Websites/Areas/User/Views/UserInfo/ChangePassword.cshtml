@using Fanex.NAP.Core.Criteria.User
@using Fanex.NAP.TGRS.Core.Resources
@model UpdatePasswordCustCriteria
@{
    bool success = ViewBag.Success != null && ViewBag.Success;

    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = ViewResources.Change_Password;
}
@section Headline {
    <div class="title">
        <div>
            <span>@HttpContext.Current.User.Identity.Name / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div class="form-bar" 
     id="divChangePassword"
     data-ng-app="tgrs.changePassword"
     data-ng-controller="changPaswordController"
     data-ng-init="initialize('@Model.OldUserPwd', '@Model.UserPwd', '@Model.ConfirmUserPwd')">
    @using (Html.BeginForm("ChangePassword", "UserInfo", FormMethod.Post, new { name = "changePassword", data_ng_submit = "submitForm(changePassword.$valid)", novalidate = true }))
    {
        <div class="form">
            <div id="divErrorSuccessMsg" class="inline-message"></div>
            <div id="divValidationSummary" class="display-none">
                @Html.ValidationSummary()
            </div>
            <div class="form-row">
                <div class="lbl-field">
                    <label for="txtOldPassword">@ViewResources.Old_Password</label>
                </div>
                <div class="edit-field">
                    <input type="text" 
                           id="txtOldPassword"
                           name="firstName"
                           class="width-200"
                           data-ng-model="user.oldPassword"
                           data-ng-mimlength="5"
                           data-tooltip="@ViewResources.InputLengthValidationMsg"
                           data-tooltip-trigger="focus"
                           data-tooltip-placement="right" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field">
                    <label for="txtUserPassword">@ViewResources.New_Password</label>
                </div>
                <div class="edit-field">
                    <input type="text" 
                           id="txtUserPassword"
                           name="newPassword"
                           class="width-200"
                           data-ng-model="user.oldPassword"
                           data-ng-mimlength="5"
                           data-tooltip="@ViewResources.InputLengthValidationMsg"
                           data-tooltip-trigger="focus"
                           data-tooltip-placement="right" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field">
                    <label for="txtConfirmPassword">@ViewResources.Confirm_Password</label>
                </div>
                <div class="edit-field">
                    <input type="text" 
                           id="txtConfirmPassword"
                           name="newPassword"
                           class="width-200"
                           data-ng-model="user.oldPassword"
                           data-ng-mimlength="5"
                           data-tooltip="@ViewResources.InputLengthValidationMsg"
                           data-tooltip-trigger="focus"
                           data-tooltip-placement="right" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field">
                </div>
                <div class="edit-field">
                    <input type="submit" id="btnSubmit" value="@ViewResources.Save" class="blue-button" />
                    <input type="button" value="@ViewResources.Cancel" class="red-button"/>
                </div>
            </div>
        </div>
    }
</div>
@section Foot {
}