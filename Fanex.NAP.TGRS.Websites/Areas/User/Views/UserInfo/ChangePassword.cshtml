@using Fanex.NAP.Core.Criteria.User
@using Fanex.NAP.TGRS.Core.Resources
@model UpdatePasswordCustCriteria
@{
    bool success = ViewBag.Success != null && ViewBag.Success;

    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = ViewResources.Change_Password;
}
@section Headline {
    <div class="title">
        <div>
            <span>@HttpContext.Current.User.Identity.Name / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div class="form-bar" 
     id="divChangePassword"
     data-ng-app="tgrs.changePassword"
     data-ng-controller="changePasswordController"
     data-ng-init="initialize('@Model.OldUserPwd', '@Model.UserPwd', '@Model.ConfirmUserPwd', '@success' === 'True')">
    <form name="changePassword" data-ng-submit="submitForm()" novalidate>
        <div class="form">
            <div data-collapse="!showSuccess" class="inline-message info">
                <p>@ViewResources.Your_changes_were_saved!</p>
            </div>
            <div data-collapse="errors.length === 0" class="inline-message error">
                <p data-ng-repeat="error in errors" data-ng-bind="error"></p>
            </div>
            <div class="form-row">
                <div class="lbl-field">
                    <label for="txtOldPassword">@ViewResources.Old_Password</label>
                </div>
                <div class="edit-field">
                    <input type="password" 
                           id="txtOldPassword"
                           name="oldPassword"
                           class="width-200"
                           data-ng-model="password.oldPassword"
                           data-ng-minlength="5"
                           data-ng-maxlength="50"
                           data-tooltip="@string.Format(ViewResources.InputLengthValidationMsg, ViewResources.First_Name, 50, 6)"
                           data-tooltip-trigger="focus"
                           data-tooltip-placement="right" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field">
                    <label for="txtUserPassword">@ViewResources.New_Password</label>
                </div>
                <div class="edit-field">
                    <input type="password" 
                           id="txtUserPassword"
                           name="newPassword"
                           class="width-200"
                           data-ng-model="password.newPassword"
                           data-ng-minlength="5"
                           data-ng-maxlength="50"
                           data-tooltip="@string.Format(ViewResources.InputLengthValidationMsg, ViewResources.First_Name, 50, 6)"
                           data-tooltip-trigger="focus"
                           data-tooltip-placement="right" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field">
                    <label for="txtConfirmPassword">@ViewResources.Confirm_Password</label>
                </div>
                <div class="edit-field">
                    <input type="password" 
                           id="txtConfirmPassword"
                           name="newPassword"
                           class="width-200"
                           data-ng-model="password.confirmPassword"
                           data-ng-minlength="5"
                           data-ng-maxlength="50"
                           data-tooltip="@string.Format(ViewResources.InputLengthValidationMsg, ViewResources.First_Name, 50, 6)"
                           data-tooltip-trigger="focus"
                           data-tooltip-placement="right" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field">
                </div>
                <div class="edit-field">
                    <input type="submit" value="@ViewResources.Save" class="blue-button" />
                    <input type="button" value="@ViewResources.Cancel" class="red-button" ng-click="cancel()"/>
                </div>
            </div>
        </div>
    </form>
</div>
@section Foot {
    @Scripts.Render("~/scripts/changePassword")
}