@using Fanex.NAP.Core.Criteria.User
@model UpdateCustCriteria
@{
    bool success = ViewBag.Success != null && ViewBag.Success;

    ViewBag.Title = ViewResources.User_Profile;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Headline {
    <div class="title">
        <div>
            <span>@HttpContext.Current.User.Identity.Name / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}

<div class="form-bar" 
     id="divProfile"
     data-ng-app="tgrs.userProfile"
     data-ng-controller="userProfileController"
     data-ng-init="initialize('@Model.FirstName', '@Model.LastName', '@Model.Email')">
    @using (Html.BeginForm("UserProfile", "UserInfo", FormMethod.Post, new { name = "userProfile", data_ng_submit = "submitForm(userProfile.$valid)", novalidate = true }))
    {
        <div data-collapse="show" >
            <p>@ViewResources.Your_changes_were_saved!</p>
        </div>
        <div class="form">
            <div class="form-row">
                <div class="lbl-field">
                    <label for="txtFirstName">@ViewResources.First_Name</label>
                </div>
                <div class="edit-field">
                    <input type="text" 
                           id="txtFirstName"
                           name="firstName"
                           class="width-200"
                           data-ng-model="user.firstName"
                           data-ng-maxlength="50"
                           data-tooltip="@ViewResources.InputLengthValidationMsg"
                           data-tooltip-trigger="focus"
                           data-tooltip-placement="right" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field">
                    <label for="txtLastName">@ViewResources.Last_Name</label>
                </div>
                <div class="edit-field">
                    <input type="text" 
                           id="txtLastName"
                           name="lastName"
                           class="width-200"
                           data-ng-model="user.lastName"
                           data-ng-maxlength="50" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field">
                    <label for="txtEmail">@ViewResources.Email</label>
                </div>
                <div class="edit-field">
                    <input type="text" 
                           id="txtEmail"
                           name="email"
                           required
                           class="width-200"
                           data-ng-pattern="/\w+([-+.]\w+)*@@\w+([-.]\w+)*\.\w+([-.]\w+)*/"
                           data-ng-model="user.email" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field">
                </div>
                <div class="edit-field">
                    <input type="submit" value="@ViewResources.Save" class="blue-button" />
                    <input type="button" value="Cancel" class="red-button" ng-click="show = !show"/>
                </div>
            </div>
        </div>
        @Html.HiddenFor(m => m.GroupId)
    }
</div>
@section Foot {
    @Scripts.Render("~/scripts/userProfile")
}