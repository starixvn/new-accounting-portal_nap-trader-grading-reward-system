@using Fanex.NAP.Core.Criteria.User
@model UpdateCustCriteria
@{
    bool success = ViewBag.Success != null && ViewBag.Success;

    ViewBag.Title = ViewResources.User_Profile;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Headline {
    <div class="title">
        <div>
            <span>@HttpContext.Current.User.Identity.Name / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}

<div class="form-bar"
     data-ng-app="tgrs.userProfile"
     data-ng-controller="userProfileController">
    <form name="userProfile" data-ng-submit="submitForm()" novalidate>
        <div class="form">
            <div data-collapse="!showMessage" class="inline-message info">
                <p>@ViewResources.Your_changes_were_saved!</p>
            </div>
            <div class="form-row">
                <div class="lbl-field width-80">
                    <label for="txtFirstName">@ViewResources.First_Name</label>
                </div>
                <div class="edit-field">
                    <input type="text" 
                           id="txtFirstName"
                           name="firstName"
                           class="width-200"
                           data-ng-init="user.firstName = '@Model.FirstName'"
                           data-ng-model="user.firstName"
                           data-ng-minlength="0"
                           data-ng-maxlength="50"
                           data-tooltip="@string.Format(ViewResources.InputLengthValidationMsg, ViewResources.First_Name, 5, 0)"
                           data-tooltip-trigger="focus"
                           data-tooltip-placement="right" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field width-80">
                    <label for="txtLastName">@ViewResources.Last_Name</label>
                </div>
                <div class="edit-field">
                    <input type="text" 
                           id="txtLastName"
                           name="lastName"
                           class="width-200"
                           data-ng-init="user.lastName = '@Model.LastName'"
                           data-ng-model="user.lastName"
                           data-ng-minlength="0"
                           data-ng-maxlength="50"
                           data-tooltip="@string.Format(ViewResources.InputLengthValidationMsg, ViewResources.First_Name, 5, 0)"
                           data-tooltip-trigger="focus"
                           data-tooltip-placement="right" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field width-80">
                    <label for="txtEmail">@ViewResources.Email</label>
                </div>
                <div class="edit-field">
                    <input type="text" 
                           id="txtEmail"
                           name="email"
                           required
                           class="width-200"
                           data-ng-init="user.email = '@Model.Email'"
                           data-ng-model="user.email"
                           data-ng-pattern="/\w+([-+.]\w+)*@@\w+([-.]\w+)*\.\w+([-.]\w+)*/"
                           data-tooltip="example@@example.com"
                           data-tooltip-trigger="focus"
                           data-tooltip-placement="right" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field width-80">
                </div>
                <div class="edit-field">
                    <input type="submit" value="@ViewResources.Save" class="blue-button" />
                    <input type="button" value="@ViewResources.Cancel" class="red-button" ng-click="cancel()"/>
                </div>
            </div>
        </div>
        <input type="hidden" data-ng-init="user.groupId = @Model.GroupId" />
        <input type="hidden" data-ng-init="success = '@success' === 'True'" />
    </form>
</div>
@section Foot {
    @Scripts.Render("~/scripts/userProfile")
}