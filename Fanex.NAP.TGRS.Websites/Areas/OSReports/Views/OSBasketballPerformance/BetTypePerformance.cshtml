@using Fanex.NAP.TGRS.OSReports.ViewModel.BasketballPerformance
@using Fanex.NAP.TGRS.OSReports
@{
    ViewBag.Title = ViewLang.PerformanceDetailReport;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head
{
    @Styles.Render("~/styles/os-basketball-performance")
}

@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}

<div class="filter-bar">
    <div id="divBetTypePerformanceFilter" class="filter-form">
        <div class="filter-row">
            <div class="lbl-field col_5">
                <label>@ViewLang.Market</label>
            </div>
            <div class="edit-field col_3">
                <select id="ddlMarket">
                    <option value="@Market.All">@ViewLang.MarketAll</option>
                    <option value="@Market.Live">@ViewLang.MarketLive</option>
                    <option value="@Market.NonLive">@ViewLang.MarketNonLive</option>
                </select>
            </div>
            <div class="date-range"><div id="divDateRange"></div></div>
            <div class="lbl-field col_3">
                <label for="ddlBetType">@ViewLang.BetType</label>
            </div>
            <div class="edit-field col_9">
                <select id="ddlBetType" multiple="multiple">
                    @foreach (var group in (IEnumerable<GroupBetTypes>)ViewBag.GroupBetTypes)
                    {
                        var check = false;
                        if (group.TotalDefaultCheckOfBetTypeList == group.BetTypeList.Count())
                        {
                            check = true;
                        }
                        <optgroup label="@group.GroupName" checked=@check>
                            @foreach (var bettype in (IEnumerable<BetType>)group.BetTypeList)
                            {
                                <option value="@bettype.BetTypeId" data-default="@bettype.IsDefaultCheck">@bettype.BetTypeName</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
        </div>
        <div class="filter-row">
            <div class="lbl-field col_5">
                <label for="txtLeague">@ViewLang.LeagueGroup</label>
            </div>
            <div class="edit-field col_6">
                <select id="ddlLeagueGroup" multiple="multiple">
                    @foreach (var leagueGroup in (IEnumerable<LeagueGroup>)ViewBag.LeagueGroups)
                    {
                        <option value=@leagueGroup.LeagueGroupId selected>@leagueGroup.LeagueGroupName</option>
                    }
                </select>
            </div>
            <div class="lbl-field col_5">
                <label for="txtLeague">@ViewLang.League</label>
            </div>
            <div class="edit-field col_5">
                <input type="text" id="txtLeague" class="input-text" maxlength="100" />
            </div>
            <div class="lbl-field col_3 bettype-bm"></div>
            <div class="submit width-auto col_4">
                <input id="btnGenerate" type="button" class="blue-button bettype-generate" value="@ViewLang.Generate" />
            </div>
        </div>
    </div>
</div>

<div id="divBetTypePerformanceContainer" class="content-grid display-none">
    <div id="divBetTypePerformanceGrid" class="freegrid"></div>
</div>


@section Foot
{
    @Scripts.Render("~/scripts/os-basketball-performance")
    <script type="text/javascript">
        var datepickerSetting = {
            MinDate: '@(((DateTime)ViewBag.MinDate).ToShortFormatedDate())',
            DefaultFromDate: '@(((DateTime)ViewBag.DefaultFromDate).ToShortFormatedDate())',
            DefaultToDate: '@(((DateTime)ViewBag.DefaultToDate).ToShortFormatedDate())',
            AllowYearRange: parseInt('@ViewBag.AllowYearRange')
        };
        var forecastBettype = '@ViewBag.ForecastBetType';
        var labels = {
            No: '#',
            BetType: '@ViewLang.BetType',
            Market: '@ViewLang.Market',
            MarketNonLive: '@ViewLang.MarketNonLive',
            MarketLive: '@ViewLang.MarketLive',
            LeagueGroup: '@ViewLang.LeagueGroup',
            NoOfLeagues: '@ViewLang.NoOfLeagues',
            NoOfTraders: '@ViewLang.NoOfTraders',
            NoOfMatches: '@ViewLang.NoOfMatches',
            NoOfBetChoices : '@ViewLang.NoOfBetChoices',
            Turnover: '@ViewLang.Turnover',
            AvgTurnoverPerMatch: '@ViewLang.AvgTurnoverPerMatch',
            WinLoss: '@ViewLang.WinLoss',
            BetCount: '@ViewLang.BetCount',
            Margin: '@ViewLang.Margin',
            Trader: '@ViewLang.Trader',
            Grade: '@ViewLang.Grade',
            Team: '@ViewLang.Team',
            Match: '@ViewLang.Match',
            League: '@ViewLang.League',
            BetTypeBM: '@ViewLang.BetTypeBM',
            Total: '@ViewLang.Total',
            GrandTotal: '@ViewLang.GrandTotal',
            AllBetTypes: '@ViewLang.AllBetTypes',
            EventDate: '@ViewLang.EventDate',
            EffectiveDate: '@ViewLang.EffectiveDate',
            NA: '@ViewLang.NA',
            Forecast: '@ViewLang.Forecast',
            AllLeagueGroups: '@ViewLang.AllLeagueGroups',
            BetTypePerformance: '@ViewLang.BetTypePerformance',
            LeaguePerformance: '@ViewLang.LeaguePerformance',
            TraderPerformance: '@ViewLang.TraderPerformance',
            MatchPerformance: '@ViewLang.MatchPerformance',
            TeamHistoryDetail: '@ViewLang.TeamHistoryDetail',
            GradeHistoryDetail: '@ViewLang.GradeHistoryDetail',
            Score: '@ViewLang.Score',
            Benchmark: '@ViewLang.BM',
            ScoreByLatestBenchMark: '@ViewLang.ScoreByLatestBenchMark',
            ScoreByPeriod: '@ViewLang.ScoreByPeriod',
            Afternoon: '@ViewLang.Afternoon',
            Night: '@ViewLang.Night',
            Midnight: '@ViewLang.Midnight',
            BetTypeBM: '@ViewLang.BetTypeBM',
            BetChoice: '@ViewLang.BetChoice'
        };
        var messages = {
            InvalidValue: '@Messages.InvalidValueError',
            RequiredField: '@Messages.RequiredFieldError'
        };
    </script>
}