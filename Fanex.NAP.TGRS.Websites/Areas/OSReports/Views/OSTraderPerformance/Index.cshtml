@{
    ViewBag.Title = "Trader Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Headline{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}

@*<div>
        <a href="#">
            <img src="../../../../Content/Themes/Images/Add.ico" style="width: 30px;height: 30px">
        </a>
    </div>*@

<div style="margin-bottom: 20px"></div>
@Html.Partial("IndexFilter")

<div id="resultContainer" class="content-grid hide">
    <div id="divGrid" class="freegrid">
    </div>
</div>

@section Foot
{
    @Scripts.Render("~/scripts/os-trader-report")

    <script type="text/javascript">
        var labels = {
            TraderPerformance: '@ViewLang.TraderPerformance'
        };
        var messages = {
            UpdateTraderSuccessfully: '@Messages.UpdateTraderSuccessfully',
            AddTraderSuccessfully: '@Messages.AddTraderSuccessfully',
            InvalidValueError: '@Messages.InvalidValueError',
            AddIssueSuccessfully: '@Messages.AddIssueSuccesfully',

        };
        var hasEditRight = '@ViewBag.HasEditRight' === 'True';

        var datepickerSetting = {
            MinDate: '@(((DateTime)ViewBag.MinDate).ToShortFormatedDate())',
            DefaultFromDate: '@(((DateTime)ViewBag.DefaultFromDate).ToShortFormatedDate())',
            DefaultToDate: '@(((DateTime)ViewBag.DefaultToDate).ToShortFormatedDate())',
            AllowYearRange: parseInt('@ViewBag.AllowYearRange')
        };
    </script>
}