@{
    bool enableReChckIn = ViewBag.ViewFlags != null && ViewBag.ViewFlags.IsReCheckin;
}
<!DOCTYPE html>
<!--[if (IE 7)]><html lang="en" class="ie7 oldie"><![endif]-->
<!--[if (IE 8)]><html lang="en" class="ie8 oldie"><![endif]-->
<!--[if (IE 9)]><html lang="en" class="ie9"><![endif]-->
<!--[if (gt IE 9)]><!-->
<html lang="en">
<!--<![endif]-->
<head>
    <meta charset="utf-8" />
    <title>@ViewLang.TGRS &mdash; @ViewBag.Title</title>
    <link rel="shortcut icon" href="~/Content/Themes/Images/tgrs.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=Edge" />
    <!--[if lt IE 9]><script src="~/Scripts/Libraries/Modernizr/modernizr.30715.min.js" type="text/javascript"></script><![endif]-->
    @Styles.Render("~/styles/common")
    @RenderSection("Head", false)
</head>
<body>
    <header>
        <a href="~/?ref=logo" class="logo">
            @ViewLang.TGR
        </a>
        @Html.Action("Menu", new RouteValueDictionary(new { controller = "Home", area = "" }))
        <div class="user-info">
            <div class="greeting">
                <h2>Welcome <span class="info-acc">@HttpContext.Current.User.Identity.Name</span><span class="info-more"></span></h2>
                <ul>
                    <li>@Html.ActionLink(ViewResources.Profile, "UserProfile", "UserInfo", new { Area = "User" }, new { })</li>
                    <li>@Html.ActionLink(ViewResources.Change_Password, "ChangePassword", "UserInfo", new { Area = "User" }, new { })</li>
                    <li>@Html.ActionLink(ViewResources.Sign_Out, "LogOut", "Login", new { Area = "User" }, new { })</li>
                </ul>
            </div>
        </div>
    </header>
    <section id="headline">
        <div class="row">
            <span class="server-time">@string.Format("{0} {1}", ViewBag.ServerDate, ViewLang.GMTMinus4)</span>
            @RenderSection("Headline", false)
        </div>
    </section>
    <section id="body">
        <div class="row content">
            @RenderBody()
        </div>
    </section>
    <div id="divPopup"></div>
    @Html.Hidden("RootURL", Url.Content("~/"))
    @Html.Hidden("AccessDeniedError", Messages.AccessDenied)
    @Html.Hidden("NotFoundError", Messages.NotFoundMessage)
    @Html.Hidden("InternalError", Messages.InternalError)
    @Html.Hidden("AllowReCheckIn", enableReChckIn)
    @Scripts.Render("~/scripts/common")
    @RenderSection("Foot", false)
</body>
</html>